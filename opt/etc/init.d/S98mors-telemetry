#!/bin/sh

case "${0}" in
	/opt/apps/mors/etc/init.d/S98mors-telemetry|/opt/etc/init.d/S98mors-telemetry)
		. /opt/apps/mors/bin/libs/telemetry_runtime || exit 1
		telemetry_runtime__pin_production
		;;
esac

ENABLED=yes
DESC="Mors telemetry sender"
PATH=${MORS_SERVICE_PATH:-/opt/sbin:/opt/bin:/opt/usr/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}

MORS_LIB_DIR=${MORS_LIB_DIR:-/opt/apps/mors/bin/libs}
TELEMETRY_INIT_WAIT_STEPS=${TELEMETRY_INIT_WAIT_STEPS:-10}
TELEMETRY_INIT_WAIT_DELAY=${TELEMETRY_INIT_WAIT_DELAY:-1}

. "${MORS_LIB_DIR}/lifecycle_state"
. "${MORS_LIB_DIR}/telemetry_store"
. "${MORS_LIB_DIR}/telemetry_process"

telemetry_init__configured() {
	telemetry_store__credentials_valid || return 1
	[ "$("${TELEMETRY_JQ}" -r '.enabled' "${TELEMETRY_CONFIG_FILE}")" = true ]
}

telemetry_init__start() {
	local pid counter=0
	printf '\033[1;37m Starting %s... \033[m' "${DESC}"
	if ! telemetry_init__configured; then
		printf '            \033[1;33m disabled. \033[m\n'
		return 0
	fi
	pid=$(telemetry_process__running_pid 2>/dev/null || true)
	if [ -n "${pid}" ]; then
		printf '            \033[1;33m already running. \033[m\n'
		return 0
	fi
	telemetry_process__cleanup_stale >/dev/null 2>&1 || true
	"${TELEMETRY_SENDER_PROGRAM}" "${TELEMETRY_SENDER_ARGUMENT}" >/dev/null 2>&1 &
	while [ "${counter}" -lt "${TELEMETRY_INIT_WAIT_STEPS}" ]; do
		pid=$(telemetry_process__running_pid 2>/dev/null || true)
		[ -n "${pid}" ] && break
		sleep "${TELEMETRY_INIT_WAIT_DELAY}"
		counter=$((counter + 1))
	done
	if [ -z "${pid}" ]; then
		printf '            \033[1;31m failed. \033[m\n'
		return 255
	fi
	printf '            \033[1;32m done. \033[m\n'
}

telemetry_init__stop() {
	local pid counter=0
	printf '\033[1;37m Shutting down %s... \033[m' "${DESC}"
	pid=$(telemetry_process__running_pid 2>/dev/null || true)
	if [ -z "${pid}" ]; then
		telemetry_process__cleanup_stale >/dev/null 2>&1 || true
		printf '            \033[1;33m already stopped. \033[m\n'
		return 0
	fi
	kill -TERM "${pid}" 2>/dev/null || true
	while telemetry_process__pid_is_sender "${pid}" && [ "${counter}" -lt "${TELEMETRY_INIT_WAIT_STEPS}" ]; do
		sleep "${TELEMETRY_INIT_WAIT_DELAY}"
		counter=$((counter + 1))
	done
	if telemetry_process__pid_is_sender "${pid}"; then
		printf '            \033[1;31m failed. \033[m\n'
		return 255
	fi
	telemetry_process__cleanup_stale >/dev/null 2>&1 || true
	printf '            \033[1;32m done. \033[m\n'
}

telemetry_init__status() {
	printf '\033[1;37m Checking %s... \033[m' "${DESC}"
	if telemetry_process__running_pid >/dev/null 2>&1; then
		printf '            \033[1;32m alive. \033[m\n'
		return 0
	fi
	printf '            \033[1;31m dead. \033[m\n'
	return 1
}

case "${1:-}" in
	start)
		[ "${ENABLED}" = yes ] || exit 8
		lifecycle_state__runtime_allowed || exit 0
		telemetry_init__start
		;;
	stop|kill) telemetry_init__stop ;;
	restart)
		[ "${ENABLED}" = yes ] || exit 8
		telemetry_init__stop || exit $?
		lifecycle_state__runtime_allowed || exit 0
		telemetry_init__start
		;;
	check|status) telemetry_init__status ;;
	*) printf 'Usage: %s {start|stop|kill|restart|status|check}\n' "$0" >&2; exit 2 ;;
esac
