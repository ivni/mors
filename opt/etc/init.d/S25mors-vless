#!/bin/sh

ENABLED=yes
DESC="Mors VLESS supervisor"
PATH=${MORS_SERVICE_PATH:-/opt/sbin:/opt/bin:/opt/usr/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}

MORS_LIB_DIR=${MORS_LIB_DIR:-/opt/apps/mors/bin/libs}
VLESS_SUPERVISOR_PID_FILE=${VLESS_SUPERVISOR_PID_FILE:-/opt/var/run/mors/vless/supervisor.pid}
VLESS_SUPERVISOR_LOCK_DIR=${VLESS_SUPERVISOR_LOCK_DIR:-/opt/var/run/mors/vless/supervisor.lock}
VLESS_SUPERVISOR_WAIT_STEPS=${VLESS_SUPERVISOR_WAIT_STEPS:-10}
VLESS_SUPERVISOR_WAIT_DELAY=${VLESS_SUPERVISOR_WAIT_DELAY:-1}

# Entware rc.func uses pidof on the configured executable. A shell script is
# visible to pidof as "sh", so using rc.func here produces false dead statuses
# and cannot safely stop or restart this service. The supervisor's own PID file
# is authoritative; /proc validation prevents signalling an unrelated process
# after PID reuse.
. "${MORS_LIB_DIR}/lifecycle_state"
. "${MORS_LIB_DIR}/vless_process"

vless_init__pid_from_file() {
	local pid=''
	pid=$(vless_process__pid_from_file "${VLESS_SUPERVISOR_PID_FILE}" service) || return 1
	printf '%s\n' "${pid}"
}

vless_init__pid_from_proc() {
	local proc_dir pid
	for proc_dir in "${VLESS_SUPERVISOR_PROC_ROOT}"/[0-9]*; do
		[ -d "${proc_dir}" ] || continue
		pid=${proc_dir##*/}
		if vless_process__pid_is_service "${pid}"; then
			printf '%s\n' "${pid}"
			return 0
		fi
	done
	return 1
}

vless_init__write_pid() {
	local pid=${1}
	umask 077
	mkdir -p "$(dirname "${VLESS_SUPERVISOR_PID_FILE}")" || return 1
	printf '%s\n' "${pid}" >"${VLESS_SUPERVISOR_PID_FILE}" || return 1
	chmod 600 "${VLESS_SUPERVISOR_PID_FILE}" 2>/dev/null || return 1
}

vless_init__running_pid() {
	local pid=''
	pid=$(vless_init__pid_from_file 2>/dev/null || true)
	if [ -z "${pid}" ]; then
		pid=$(vless_init__pid_from_proc 2>/dev/null || true)
		[ -n "${pid}" ] || return 1
		vless_init__write_pid "${pid}" || return 1
	fi
	printf '%s\n' "${pid}"
}

vless_init__cleanup_stale() {
	local pid=''
	pid=$(vless_process__read_pid "${VLESS_SUPERVISOR_PID_FILE}" 2>/dev/null || true)
	if [ -n "${pid}" ] && vless_process__pid_is_program "${pid}"; then
		return 1
	fi
	rm -f "${VLESS_SUPERVISOR_PID_FILE}"
	rmdir "${VLESS_SUPERVISOR_LOCK_DIR}" 2>/dev/null || true
}

vless_init__terminate_children() {
	local parent=${1} status child ppid current_ppid
	for status in "${VLESS_SUPERVISOR_PROC_ROOT}"/[0-9]*/status; do
		[ -r "${status}" ] || continue
		child=${status%/status}
		child=${child##*/}
		ppid=$(sed -n 's/^PPid:[[:space:]]*//p' "${status}" 2>/dev/null | head -n 1)
		[ "${ppid}" = "${parent}" ] || continue
		current_ppid=$(sed -n 's/^PPid:[[:space:]]*//p' "${VLESS_SUPERVISOR_PROC_ROOT}/${child}/status" 2>/dev/null | head -n 1)
		[ "${current_ppid}" = "${parent}" ] || continue
		kill -TERM "${child}" 2>/dev/null || true
	done
}

vless_init__start() {
	local pid counter=0
	printf '\033[1;37m Starting %s... \033[m' "${DESC}"
	pid=$(vless_init__running_pid 2>/dev/null || true)
	if [ -n "${pid}" ]; then
		printf '            \033[1;33m already running. \033[m\n'
		return 0
	fi
	if ! vless_init__cleanup_stale; then
		printf '            \033[1;33m supervisor operation is busy. \033[m\n'
		return 255
	fi
	(
		# The init action may be authorized by a short-lived setup transaction.
		# The long-lived worker must evaluate subsequent runtime state without
		# inheriting that temporary lifecycle capability.
		unset MORS_LIFECYCLE_APPLY MORS_RUNTIME_LOCK_TOKEN MORS_RUNTIME_LOCK_DEPTH
		exec "${VLESS_SUPERVISOR_PROGRAM}" "${VLESS_SUPERVISOR_ARGUMENT}"
	) >/dev/null 2>&1 &
	pid=$!
	if ! vless_init__write_pid "${pid}"; then
		kill "${pid}" 2>/dev/null || true
		vless_init__cleanup_stale >/dev/null 2>&1 || true
		printf '            \033[1;31m failed. \033[m\n'
		return 255
	fi
	while ! vless_process__pid_is_service "${pid}" && kill -0 "${pid}" 2>/dev/null && [ "${counter}" -lt "${VLESS_SUPERVISOR_WAIT_STEPS}" ]; do
		sleep "${VLESS_SUPERVISOR_WAIT_DELAY}"
		counter=$((counter + 1))
	done
	if ! vless_process__pid_is_service "${pid}"; then
		kill "${pid}" 2>/dev/null || true
		vless_init__cleanup_stale >/dev/null 2>&1 || true
		printf '            \033[1;31m failed. \033[m\n'
		return 255
	fi
	printf '            \033[1;32m done. \033[m\n'
}

vless_init__stop() {
	local pid counter=0
	printf '\033[1;37m Shutting down %s... \033[m' "${DESC}"
	pid=$(vless_init__running_pid 2>/dev/null || true)
	if [ -z "${pid}" ]; then
		vless_init__cleanup_stale >/dev/null 2>&1 || true
		printf '            \033[1;33m already stopped. \033[m\n'
		return 0
	fi
	kill "${pid}" 2>/dev/null || true
	while vless_process__pid_is_service "${pid}" && [ "${counter}" -lt "${VLESS_SUPERVISOR_WAIT_STEPS}" ]; do
		# BusyBox ash can defer the parent's TERM trap while it waits for a
		# foreground probe. Revalidate PPid on every pass and terminate only
		# direct children of this exact supervisor so the trap can run.
		vless_init__terminate_children "${pid}"
		sleep "${VLESS_SUPERVISOR_WAIT_DELAY}"
		counter=$((counter + 1))
	done
	if vless_process__pid_is_service "${pid}"; then
		printf '            \033[1;31m failed. \033[m\n'
		return 255
	fi
	vless_init__cleanup_stale >/dev/null 2>&1 || true
	printf '            \033[1;32m done. \033[m\n'
}

vless_init__status() {
	printf '\033[1;37m Checking %s... \033[m' "${DESC}"
	if vless_init__running_pid >/dev/null 2>&1; then
		printf '            \033[1;32m alive. \033[m\n'
		return 0
	fi
	printf '            \033[1;31m dead. \033[m\n'
	return 1
}

vless_init__wake() {
	local pid
	pid=$(vless_init__running_pid) || return 1
	kill -USR1 "${pid}"
}

case "${1:-}" in
	start)
		[ "${ENABLED}" = yes ] || exit 8
		lifecycle_state__runtime_allowed || exit 0
		vless_init__start
		;;
	stop|kill)
		vless_init__stop
		;;
	restart)
		[ "${ENABLED}" = yes ] || exit 8
		lifecycle_state__runtime_allowed || exit 0
		vless_init__stop && vless_init__start
		;;
	check|status)
		vless_init__status
		;;
	reconfigure)
		vless_init__wake
		;;
	*)
		printf 'Usage: %s {start|stop|kill|restart|status|check|reconfigure}\n' "$0" >&2
		exit 2
		;;
esac
