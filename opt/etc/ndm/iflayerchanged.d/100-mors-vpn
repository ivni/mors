if [ "${1}" = "hook" ]; then
	. /opt/apps/mors/bin/libs/lifecycle_state
	lifecycle_state__runtime_allowed || exit 0
	# Подключаем библиотеку с функциями обработки ndm
	. /opt/apps/mors/bin/libs/ndm_d
	cli_inface="$(inface_cli)"
fi

if [ "${1}" = "hook" ] && echo "${id}" | grep -q "${cli_inface}"; then
	ndm_runtime__begin interface_layer_changed || exit $?

	case "${layer}-${level}" in

#		Запускаем обработку при поднятии соединения
		"ctrl-running")
			cmd_vpn_iptable_reset &> /dev/null
#			link_up &> /dev/null
			logger -t "МОРС"  "Соединение ${id} успешно подключено."
		;;

#		Запускаем обработку при отключении соединении
		"ctrl-disabled" )
			link_reboot "${cli_inface}" &> /dev/null
			logger -t "МОРС"  "Соединение ${id} успешно завершено."
		;;

	esac
	ndm_runtime__end

fi

