# Расширенный роутинг для перехватов цепочками. Для команд:
# route by_list ip add — роутинг по списку для IP
# route full ip add — роутинг всего трафика для IP
ip4__add_routing_for_ip_from_config() {
	local regexp_ip_or_range=$(get_regexp_ip_or_range)

	local values=$(get_config_value 'route_full_ip')
	if [ -n "${values}" ] ; then
		IFS=' '
		for ip_or_range in ${values//+/ } ; do
			# защита от дурака; не обязательна, если проверять входящие данные
			if ! echo "${ip_or_range}" | grep -qE -- "${regexp_ip_or_range}" ; then
				continue
			fi

			ip_or_range=$(ip4__get_subrule_for_ip "${ip_or_range}")
			if is_shadowsocks_enabled ; then
				ip4__add_routing "${TABLE_DNAT_TO_PORT}"  "${CHAIN_DNAT_TO_PORT}"  "${ip_or_range}" || return 1
			else
				ip4__add_routing "${TABLE_MARK}" "${CHAIN_MARK}" "${ip_or_range}" || return 1
			fi
		done
	fi

	values=$(get_config_value 'route_by_list_ip')
	if [ -n "${values}" ] ; then
		IFS=' '
		for ip_or_range in ${values//+/ } ; do
			# защита от дурака; не обязательна, если проверять входящие данные
			if ! echo "${ip_or_range}" | grep -qE -- "${regexp_ip_or_range}" ; then
				continue
			fi

			ip_or_range=$(ip4__get_subrule_for_ip "${ip_or_range}")
			if is_shadowsocks_enabled ; then
				ip4__add_routing "${TABLE_DNAT_TO_PORT}"  "${CHAIN_DNAT_TO_PORT}"  "${ip_or_range}" "${IPSET_TABLE_NAME}" || return 1
			else
				ip4__add_routing "${TABLE_MARK}" "${CHAIN_MARK}" "${ip_or_range}" "${IPSET_TABLE_NAME}" || return 1
			fi
		done
	fi
}

ip4_mark_vpn_network() {
	{
		ip4__mark__create_chain || return 1

		# Сначала правила по IP, затем по сетям.
		ip4__add_routing_for_ip_from_config || return 1
		ip4__add_routing_by_list_for_net_from_config || return 1

		#ToDo: сделать home отключаемой
		ip4__mark__add_routing_for_home || return 1
	} &>/dev/null
}

ip4_firewall_set_all_rules() {
	if is_shadowsocks_enabled ; then
		ip4__shadowsocks__create_chain &>/dev/null || return 1

		# Сначала правила по IP, затем по сетям
		ip4__add_routing_for_ip_from_config &> /dev/null || return 1
		ip4__add_routing_by_list_for_net_from_config &> /dev/null || return 1

		#ToDo: сделать home отключаемой
		ip4__shadowsocks__add_routing_for_home &> /dev/null || return 1
	else
		ip4_mark_vpn_network || return 1
	fi
	return 0
}


