# может прибрать всё (с убиванием цепочек и наборов)
ip4__flush() {
	if [ -z "${1}" ] ; then
		local parts=' net ip jump chain table ipset '
	else
		local parts=" ${1} "
	fi

	# если не нужно точечно, то используем общий jump
	if echo "${parts}" | grep -Fq ' net ' ; then
		ip4__delete_routing_by_list_for_net_from_config || return 1
	fi
	if echo "${parts}" | grep -Fq ' ip ' ; then
		ip4__delete_routing_for_ip_from_config || return 1
	fi

	if echo "${parts}" | grep -Fq ' table ' ; then
		ip4__rule__delete_mark_to_table || return 1
		ip4__route__flush_table || return 1
	fi

	if echo "${parts}" | grep -Fq ' chain ' ; then
		ip4__chain__delete_jump "${TABLE_DNS}" "${CHAIN_DNS}" || return 1
		ip4__chain__delete      "${TABLE_DNS}" "${CHAIN_DNS}" || return 1

		# можно оптимизировать, удаляя лишь нужный с проверкой is_shadowsocks_enabled
		# но тогда нужно переписать код в смене интерфейса
		ip4__chain__delete_jump "${TABLE_DNAT_TO_PORT}" "${CHAIN_DNAT_TO_PORT}" || return 1
		ip4__chain__delete      "${TABLE_DNAT_TO_PORT}" "${CHAIN_DNAT_TO_PORT}" || return 1
		ip4__chain__delete_jump "${TABLE_MARK}" "${CHAIN_MARK}" || return 1
		ip4__chain__delete      "${TABLE_MARK}" "${CHAIN_MARK}" || return 1

		# если привязана к какой-то исторической цепочке, может упасть
		ip4__ipset__destroy_destination_excluded || return 1
	elif echo "${parts}" | grep -Fq ' jump ' ; then
		ip4__chain__delete_jump "${TABLE_DNS}"          "${CHAIN_DNS}" || return 1

		# можно оптимизировать, удаляя лишь нужный с проверкой is_shadowsocks_enabled
		# но тогда нужно переписать код в смене интерфейса
		ip4__chain__delete_jump "${TABLE_DNAT_TO_PORT}" "${CHAIN_DNAT_TO_PORT}" || return 1
		ip4__chain__delete_jump "${TABLE_MARK}"         "${CHAIN_MARK}" || return 1
	fi

	if echo "${parts}" | grep -Fq ' ipset ' ; then
		ip4__ipset__destroy_list || return 1
	fi
	return 0
}


