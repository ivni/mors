# ------------------------------------------------------------------------------------------
#
# Подключение и отключение перехвата DNS
#
# ------------------------------------------------------------------------------------------

# Leaves a failed partial rebuild unreachable: prefer an empty chain, then a
# safe RETURN guard, and detach all jumps only as the last fallback.
ip4__dns__deactivate_partial_chain() {
	iptab -F "${CHAIN_DNS}" -w -t "${TABLE_DNS}" >/dev/null 2>&1 && return 0
	iptab -I "${CHAIN_DNS}" 1 -w -t "${TABLE_DNS}" -j RETURN >/dev/null 2>&1 && return 0
	ip4__chain__delete_jump "${TABLE_DNS}" "${CHAIN_DNS}" || return 1
}

# Создаёт или восстанавливает содержимое цепочки для DNS редиректа.
# Existing jumps remain attached so every configured network scope and priority survive repair.
ip4__dns__create_chain() {
	ip4__chain__is_exist "${TABLE_DNS}" "${CHAIN_DNS}"
	case $? in
		0)
			ip4__dns_chain_has_required_rules
			case $? in
				0) return 0 ;;
				1)
					log_warning 'Восстановление цепочки для DNS перенаправления'
					iptab -F "${CHAIN_DNS}" -w -t "${TABLE_DNS}" || return 1
					;;
				*) return 1 ;;
			esac
			;;
		1)
			log_warning 'Создание цепочки для DNS перенаправления'
			iptab -N "${CHAIN_DNS}" -w -t "${TABLE_DNS}" || return 1
			;;
		*) return 1 ;;
	esac

	ip4__chain__exclude_source_by_config "${TABLE_DNS}" "${CHAIN_DNS}" || {
		ip4__dns__deactivate_partial_chain ||
			error "[${FUNCNAME}] Не удалось безопасно отключить частичную DNS-цепочку"
		return 1
	}

	IFS=' '
	for protocol in udp tcp ; do
		# не будет ли задвоения без -w?
		iptab -A "${CHAIN_DNS}" -t "${TABLE_DNS}" -p "${protocol}" --dport 53 -j DNAT --to-destination 127.0.0.1:"${DNS_PORT}" || {
			ip4__dns__deactivate_partial_chain ||
				error "[${FUNCNAME}] Не удалось безопасно отключить частичную DNS-цепочку"
			return 1
		}
	done
}

# Возвращает номер правила из переданного checked snapshot nat PREROUTING.
ip4__get_rulenum() {
	if [ -z "${1}" ]; then
		error "[${FUNCNAME}] Не передан обязательный параметр — правило для поиска"
		return 1
	fi
	local find="${1}"

	[ "${2+x}" = x ] || {
		error "[${FUNCNAME}] Не передан обязательный checked snapshot"
		return 1
	}
	local snapshot=${2}

	printf '%s\n' "${snapshot}" | awk -v expected_target="${find}" '
		$1 == "-A" && $2 == "PREROUTING" {
			rulenum++
			jump = ""
			for (i = 3; i <= NF; i++) {
				if ($i == "-j" && i < NF) { jump = $(i + 1); break }
			}
			if (jump == expected_target) { print rulenum; exit }
		}
	'
}

# Возвращает номер (в PREROUTING) для DNS-правил
ip4__dns__get_rulenum() {
	local snapshot rulenum
	snapshot=$(save_iptables -t "${TABLE_DNS}") || return 1

	# вместо NDM_DNS_REDIRECT
	rulenum=$(ip4__get_rulenum 'NDM_DNS_REDIRECT' "${snapshot}") || return 1
	if [ -n "${rulenum}" ]; then
		echo "${rulenum}"
		return
	fi

	# после NDM_DNAT
	rulenum=$(ip4__get_rulenum 'NDM_DNAT' "${snapshot}") || return 1
	if [ -n "${rulenum}" ]; then
		echo $((rulenum + 1))
		return
	fi

	# высший приоритет
	# если DNS перехват не будет работать, удаляем вышестоящее
	echo '1'
}

# Перенаправляем dns-запросы в dnsmasq
#Example input param:-s 192.168.3.0/24 -i eth3
#Example input param:-i sstp+
ip4__dns__add_routing() {
	local iptables_filter
	local submessage result
	if [ -n "${1}" ]; then
		iptables_filter=$(echo "${1}" | xargs)
		submessage=" по критерию ${iptables_filter}"
		iptables_filter=" ${iptables_filter}"
	else
		iptables_filter=''
		submessage=''
	fi

	# Validate or rebuild the managed chain before accepting an existing jump.
	# A rebuild removes stale jumps, so the insertion-position snapshot must be later.
	ip4__dns__create_chain || return 1

	ip4__prerouting_jump_has_required_rule "${TABLE_DNS}" "${iptables_filter}" "${CHAIN_DNS}"
	result=$?
	case ${result} in
		0) return 0 ;;
		1) ip4__prerouting_jump_delete_near_misses "${TABLE_DNS}" "${iptables_filter}" "${CHAIN_DNS}" || return 1 ;;
		*) return 1 ;;
	esac
	local rulenum
	rulenum=$(ip4__dns__get_rulenum) || return 1

	log_warning "Подключение DNS перенаправления с приоритетом ${rulenum}${submessage}"

	# без echo дублирование пробелов (что даёт warning и проблему наличия)
	iptab -I PREROUTING "${rulenum}" -w -t "${TABLE_DNS}"$(echo "${iptables_filter}") -j "${CHAIN_DNS}"
}

# Отключение перехвата dns-запросов в dnsmasq
#Example input param:-s 192.168.3.0/24 -i eth3
#Example input param:-i sstp+
ip4__dns__delete_routing() {
	local iptables_filter
	local submessage snapshot
	if [ -n "${1}" ]; then
		iptables_filter=$(echo "${1}" | xargs)
		submessage=" по критерию ${iptables_filter}"
		iptables_filter=" ${iptables_filter}"
	else
		iptables_filter=''
		submessage=''
	fi

	snapshot=$(save_iptables) || return 1
	if ! printf '%s\n' "${snapshot}" | grep -F 'PREROUTING' | grep -F -- "${iptables_filter}" | grep -Fq "${CHAIN_DNS}" ; then
		return
	fi

	log_warning "Отключение DNS перенаправления${submessage}"

	# без echo дублирование пробелов (что даёт warning и проблему наличия)
	/opt/sbin/iptables -D PREROUTING -t "${TABLE_DNS}"$(echo "${iptables_filter}") -j "${CHAIN_DNS}"
}


