ip4__route__flush_cache() {
	log_warning 'Очистка кэша маршрутизации'

	/opt/sbin/ip route flush cache &>/dev/null
}

ip4__route__show_table() {
	if [ -z "${1}" ] ; then
		error "[${FUNCNAME}] Не задан обязательный аргумент — id таблицы"
		return 1
	fi
	local table_id="${1}" route_output route_status

	route_output=$(ip4 route show table "${table_id}" 2>&1)
	route_status=$?
	if [ "${route_status}" -ne 0 ]; then
		case "${route_output}" in
			*'FIB table does not exist'*) return 1 ;;
		esac
		[ -z "${route_output}" ] || error "[${FUNCNAME}] Ошибка чтения таблицы ${table_id}: ${route_output}"
		return 2
	fi
	printf '%s\n' "${route_output}"
}

ip4__route__is_exist_table() {
	if [ -z "${1}" ] ; then
		error "[${FUNCNAME}] Не задан обязательный аргумент — id таблицы"
		return 1
	fi
	local table_id="${1}" routes route_status

	routes=$(ip4__route__show_table "${table_id}")
	route_status=$?
	case "${route_status}" in
		0) ;;
		1) return 1 ;;
		*) return 2 ;;
	esac
	[ -n "${routes}" ]
}

ip4__route__has_canonical_default() {
	local expected_interface=${1:-} expected_gateway=${2:-}
	[ -n "${expected_interface}" ] || return 1
	awk -v expected_interface="${expected_interface}" -v expected_gateway="${expected_gateway}" '
		$1 == "unreachable" || $1 == "blackhole" || $1 == "prohibit" ||
		$1 == "throw" { if ($2 == "default") { defaults++; bad = 1 }; next }
		$1 == "default" {
			defaults++; dev = via = ""; dev_count = via_count = invalid = 0
			for (i = 2; i <= NF; i++) {
				if ($i == "dev" && i < NF) { dev = $(++i); dev_count++ }
				else if ($i == "via" && i < NF) { via = $(++i); via_count++ }
				else if (($i == "metric" || $i == "proto" || $i == "scope" ||
					$i == "src" || $i == "pref" || $i == "mtu") && i < NF) i++
				else if ($i == "onlink") continue
				else invalid = 1
			}
			if (invalid || dev_count != 1 || dev != expected_interface || via_count > 1) bad = 1
			if (expected_gateway == "" && via_count != 0) bad = 1
			if (expected_gateway != "" && (via_count != 1 || via != expected_gateway)) bad = 1
		}
		END { exit(defaults == 1 && !bad ? 0 : 1) }
	'
}

ip4__route__add_table() {
	local net_interface=$(get_config_value 'INFACE_ENT')
	local is_need_flush=''

	local gateway_ip=$(get_config_value 'ADDR_MAN')
	if [ -n "${gateway_ip}" ] ; then
		local subroute=" via ${gateway_ip}"
		local submessage=" через ${gateway_ip}"
	else
		local subroute=''
		local submessage=''
	fi
	subroute="default${subroute} dev ${net_interface}"
	submessage="таблицы маршрутизации ${ROUTE_TABLE_ID} для ${net_interface}${submessage}"

	local route_show route_status
	route_show=$(ip4__route__show_table "${ROUTE_TABLE_ID}")
	route_status=$?
	case "${route_status}" in
		0) ;;
		1) route_show='' ;;
		*) return 1 ;;
	esac
	if [ -n "${route_show}" ] && ! printf '%s\n' "${route_show}" | \
		ip4__route__has_canonical_default "${net_interface}" "${gateway_ip}"; then
		# В таблице нет единственного эффективного default через выбранный тоннель.
		log_warning "Очистка таблицы маршрутизации ${ROUTE_TABLE_ID} из-за конфликтующего default route"
		ip4 route flush table "${ROUTE_TABLE_ID}" &>/dev/null || return 1

		is_need_flush='1'

		# чтобы передобавилось ниже
		route_show=$(ip4__route__show_table "${ROUTE_TABLE_ID}")
		route_status=$?
		case "${route_status}" in
			0) ;;
			1) route_show='' ;;
			*) return 1 ;;
		esac
	fi

	if [ -z "${route_show}" ] ; then
		log_warning "Добавление ${submessage}"

		if ! ip4 route add table "${ROUTE_TABLE_ID}" $(echo "${subroute}") ; then
			error "[${FUNCNAME}] Ошибка при добавлении ${submessage}"
			return 1
		fi

		is_need_flush='2'
	fi

	# Обычному VPN без явного gateway нужен маршрут к сети gateway. Keenetic
	# Proxy — point-to-point интерфейс: для него достаточно default dev t2sN.
	if [ -z "${gateway_ip}" ] && [ "${net_interface}" != "${PROXY_VLESS_ENTWARE:-t2s21}" ] ; then
		gateway_ip=$(get_ip_by_inface "${net_interface}")
		if [ -z "${gateway_ip}" ] ; then
			error "[${FUNCNAME}] При добавлении в таблицу маршрутизации ${ROUTE_TABLE_ID} не удалось определить IP шлюза для ${net_interface}"
			return 1
		else
			local gateway_net=$(get_net_by_ip "${gateway_ip}")
			subroute="${gateway_net} via ${gateway_ip}" # dev ${net_interface}
			submessage="в таблицу маршрутизации ${ROUTE_TABLE_ID} для ${gateway_net} через ${gateway_ip}"

			if ! echo "${route_show}" | grep -Fq "${subroute}" ; then
				log_warning "Добавление ${submessage}"

				if ! ip4 route add $(echo "${subroute}") table "${ROUTE_TABLE_ID}" ; then
					error "[${FUNCNAME}] Ошибка при добавлении ${submessage}"
					return 1
				fi

				is_need_flush='3'
			fi
		fi
	fi

	if [ -n "${is_need_flush}" ] ; then
		ip4__route__flush_cache || return 1
	fi
}

ip4__route__flush_table() {
	ip4__route__is_exist_table "${ROUTE_TABLE_ID}"
	case $? in
		0) ;;
		1) return 0 ;;
		*) return 1 ;;
	esac

	log_warning "Очистка таблицы маршрутизации ${ROUTE_TABLE_ID}"

	ip4 route flush table "${ROUTE_TABLE_ID}" \
	 || {
		error "[${FUNCNAME}] Ошибка при очистке таблицы маршрутизации ${ROUTE_TABLE_ID}"
		return 1
	}

	ip4__route__flush_cache || return 1
}

