ip4__chain__discard_partial() {
	local table=${1} chain_name=${2}
	ip4__chain__delete_jump "${table}" "${chain_name}" >/dev/null 2>&1 || true
	ip4__chain__delete "${table}" "${chain_name}" >/dev/null 2>&1 || true
	return 1
}

ip4__chain__exclude_source_by_config() {
	if [ -z "${1}" ] ; then
		error "[${FUNCNAME}] Не задан обязательный аргумент — таблица"
		return
	fi
	local table="${1}"

	if [ -z "${2}" ] ; then
		error "[${FUNCNAME}] Не задан обязательный аргумент — цепочка"
		return 1
	fi
	local chain_name="${2}"

	local values=$(get_config_value 'route_excluded_ip')
	if [ -z "${values}" ] ; then
		return
	fi
	local regexp_ip_or_range=$(get_regexp_ip_or_range)

	IFS=' '
	for ip_or_range in ${values//+/ } ; do
		# защита от дурака; не обязательна, если проверять входящие данные
		if ! echo "${ip_or_range}" | grep -qE -- "${regexp_ip_or_range}" ; then
			continue
		fi

		log_warning "Исключение ${ip_or_range} из ${chain_name}"

		/opt/sbin/iptables -A "${chain_name}" -w -t "${table}" -s "${ip_or_range}" -j RETURN || return 1
	done
}

# Создаёт (если нет) цепочку для роутинга данных
ip4__chain__create_for_data() {
	if [ -z "${1}" ] ; then
		error "[${FUNCNAME}] Не задан обязательный аргумент — таблица"
		return 1
	fi
	local table="${1}"

	if [ -z "${2}" ] ; then
		error "[${FUNCNAME}] Не задан обязательный аргумент — цепочка"
		return 1
	fi
	local chain_name="${2}"

	ip4__chain__is_exist "${table}" "${chain_name}"
	case $? in
		0) return 0 ;;
		1) ;;
		*) return 1 ;;
	esac

	log_warning "Создание цепочки ${chain_name} в ${table} для данных"

	/opt/sbin/iptables -N "${chain_name}" -w -t "${table}" || return 1

	ip4__chain__exclude_source_by_config "${table}" "${chain_name}" || return 1

	ip4__ipset__fill_destination_excluded || return 1
	/opt/sbin/iptables -A "${chain_name}" -w -t "${table}" -m set --match-set "${IPSET_DESTINATION_EXCLUDED}" dst -j RETURN || return 1

	# если цепочка данных будет подключена выше DNS, то она может 
	# перехватить направленный вовне трафик
	IFS=' '
	for protocol in udp tcp ; do
		/opt/sbin/iptables -A "${chain_name}" -w -t "${table}" -p "${protocol}" --dport 53 -j RETURN || return 1
	done
}

ip4__chain__delete() {
	if [ -z "${1}" ] ; then
		error "[${FUNCNAME}] Не задан обязательный аргумент — таблица"
		return
	fi
	local table="${1}"

	if [ -z "${2}" ] ; then
		error "[${FUNCNAME}] Не задан обязательный аргумент — цепочка"
		return 1
	fi
	local chain_name="${2}"

	ip4__chain__is_exist "${table}" "${chain_name}"
	case $? in
		0) ;;
		1) return 0 ;;
		*) return 1 ;;
	esac

	log_warning "Удаление цепочки ${chain_name} в ${table}"

	/opt/sbin/iptables -F "${chain_name}" -t "${table}" || return 1
	/opt/sbin/iptables -X "${chain_name}" -t "${table}" || return 1
}

# удаляем входы в цепочку
ip4__chain__delete_jump() {
	if [ -z "${1}" ] ; then
		error "[${FUNCNAME}] Не задан обязательный аргумент — таблица"
		return 1
	fi
	local table="${1}"

	if [ -z "${2}" ] ; then
		error "[${FUNCNAME}] Не задан обязательный аргумент — цепочка"
		return 1
	fi
	local chain_name="${2}"

	iptables__delete_rules "${table}" "-j ${chain_name}"
}


# ------------------------------------------------------------------------------------------
#
# Создание цепочек
#
# ------------------------------------------------------------------------------------------

ip4__dnat_to_port__create_chain() {
	if [ -z "${1}" ] ; then
		error "[${FUNCNAME}] Не задан обязательный аргумент — таблица"
		return 1
	fi
	local table="${1}"

	if [ -z "${2}" ] ; then
		error "[${FUNCNAME}] Не задан обязательный аргумент — цепочка"
		return 1
	fi
	local chain_name="${2}"

	if [ -z "${3}" ] ; then
		error "[${FUNCNAME}] Не задан обязательный аргумент — порт"
		return 1
	fi
	local port="${3}"

	ip4__chain__is_exist "${table}" "${chain_name}"
	case $? in
		0)
			ip4__dnat_chain_has_required_rules "${table}" "${chain_name}" "${port}"
			case $? in
				0)
					ip4__ipset__fill_destination_excluded || return 1
					return 0
					;;
				1)
					ip4__chain__delete_jump "${table}" "${chain_name}" || return 1
					ip4__chain__delete "${table}" "${chain_name}" || return 1
					;;
				*) return 1 ;;
			esac
			;;
		1) ;;
		*) return 1 ;;
	esac

	if ! (
		ip4__chain__create_for_data "${table}" "${chain_name}" || exit 1

		IFS=' '
		for protocol in udp tcp ; do
			# не будет ли задвоения без -w?
			iptab -A "${chain_name}" -t "${table}" -p "${protocol}" -j REDIRECT --to-port "${port}" || exit 1
		done
	); then
		error "[${FUNCNAME}] Возникли ошибки при установке правил трафика для прокси"
		ip4__chain__discard_partial "${table}" "${chain_name}" >/dev/null 2>&1
		return 1
	fi
	return 0
}

ip4__shadowsocks__create_chain() {
	local local_port
	local_port=$(get_config_value SSR_DNS_PORT)
	#local_port=$(get_from_json "${VLESS_CONFIG_FILE}" 'port' 'inbounds')

	ip4__dnat_to_port__create_chain "${TABLE_DNAT_TO_PORT}" "${CHAIN_DNAT_TO_PORT}" "${local_port}"
}

ip4__mark__create_chain() {
	ip4__chain__is_exist "${TABLE_MARK}" "${CHAIN_MARK}"
	case $? in
		0)
			ip4__mark__has_required_rules
			case $? in
				0)
					# A complete chain is only one part of the MARK dataplane.
					# Reconcile its destination exclusions, policy table and rule on every retry.
					ip4__ipset__fill_destination_excluded || return 1
					ip4__route__add_table || return 1
					ip4__rule__add_mark_to_table || return 1
					return 0
					;;
				1)
					ip4__chain__delete_jump "${TABLE_MARK}" "${CHAIN_MARK}" || return 1
					ip4__chain__delete "${TABLE_MARK}" "${CHAIN_MARK}" || return 1
					;;
				*) return 1 ;;
			esac
			;;
		1) ;;
		*) return 1 ;;
	esac

	if ! (
		ip4__chain__create_for_data "${TABLE_MARK}" "${CHAIN_MARK}" || exit 1

		# т.к. мы начнём маркировать трафик, то заранее
		# стартанём таблицы для него и повесим правило захвата
		ip4__route__add_table || exit 1
		ip4__rule__add_mark_to_table || exit 1

		# Ещё есть 2 варианта цепочки, если проблемы.
		# Где conntrack NEW лишь на -j MARK, т.е. save-mark всегда.
		# Где полностью без --ctstate.
		if is_vless_over_proxy_enabled ; then
			log_warning 'Включение маркировки VLESS'

			iptab -w -t "${TABLE_MARK}" -A "${CHAIN_MARK}" -p icmp -j RETURN || exit 1

			iptab -w -t "${TABLE_MARK}" -A "${CHAIN_MARK}" -j CONNMARK --restore-mark || exit 1
			iptab -w -t "${TABLE_MARK}" -A "${CHAIN_MARK}" -m mark --mark ${MARK_NUM} -j RETURN || exit 1

			# не переносим маркер обратно для каждого пакета
			iptab -w -t "${TABLE_MARK}" -A "${CHAIN_MARK}" -m conntrack ! --ctstate NEW -j RETURN || exit 1
		else
			log_warning 'Включение маркировки VPN'

			# Не переносим маркер для каждого пакета в случае TCP.
			# На отдельных устройствах, к сожалению, не работает.
			#/opt/sbin/iptables -w -t "${TABLE_MARK}" -A "${CHAIN_MARK}" -p tcp -m conntrack ! --ctstate NEW -j RETURN

			iptab -w -t "${TABLE_MARK}" -A "${CHAIN_MARK}" -j CONNMARK --restore-mark || exit 1
			iptab -w -t "${TABLE_MARK}" -A "${CHAIN_MARK}" -m mark --mark ${MARK_NUM} -j RETURN || exit 1

			#/opt/sbin/iptables -w -t "${TABLE_MARK}" -A "${CHAIN_MARK}" ! -p tcp -m conntrack ! --ctstate NEW -j RETURN
			iptab -w -t "${TABLE_MARK}" -A "${CHAIN_MARK}" -m conntrack ! --ctstate NEW -j RETURN || exit 1
		fi
		iptab -w -t "${TABLE_MARK}" -A "${CHAIN_MARK}" -j MARK --set-mark ${MARK_NUM} || exit 1
		iptab -w -t "${TABLE_MARK}" -A "${CHAIN_MARK}" -j CONNMARK --save-mark || exit 1
	); then
		error "[${FUNCNAME}] Возникли ошибки во время маркировки трафика для VPN"
		ip4__chain__discard_partial "${TABLE_MARK}" "${CHAIN_MARK}" >/dev/null 2>&1
		return 1
	fi
	return 0
}


