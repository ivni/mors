#!/bin/sh
. /opt/apps/mors/bin/libs/runtime_lock
runtime_mutation_lock__acquire 'mors dnsmasq worker' || exit $?
trap 'runtime_mutation_lock__release >/dev/null 2>&1 || true' 0
trap 'runtime_mutation_lock__release >/dev/null 2>&1 || true; trap - 0 HUP INT TERM; exit 130' HUP INT TERM

#------------------------------------------------------------------------------
#
#	ПАКЕТ МОРС
#
#------------------------------------------------------------------------------
#
#	Данный файл служит для формирования из записей mors.list
#	специальных записей вида "ipset=/хост/mors"
# 	для конфигурационного файла dnsmasq типа, которые
# 	записыватся в /opt/etc/dnsmasq.d/mors.dnsmasq.
#
# -----------------------------------------------------------------------------
#	Разработчик: mail@zeleza.ru
#	Дата создания: 21/05/2022
#	Лицензия: Apache License 2.0
# -----------------------------------------------------------------------------

# если делать этот файл автономно запускаемым, то нужна
#. /opt/apps/mors/bin/libs/main

logger -t 'МОРС' 'Обновление доменной конфигурации DNSMasq'

IPSET_TABLE_NAME=MORS_LIST
ipset_file=/opt/etc/dnsmasq.d/mors.dnsmasq
host_list=/opt/etc/mors.list
LOCALHOST_IP=127.0.0.1

dnsmasq__render_list() {
  local source_file destination_file line host expected=0 created
  source_file=${1}
  destination_file=${2}
  [ -r "${source_file}" ] || return 1
  : >"${destination_file}" || return 1

  while read -r line || [ -n "${line}" ]; do
    # Удаляем комментарий, сжимаем пробелы и пропускаем пустые строки.
    line=$(printf '%s\n' "${line}" | sed 's/#.*$//g; s/^[[:space:]]*//; s/[[:space:]]*$//' | tr -s ' ')
    [ -z "${line}" ] && continue

    # IP-адреса и сети заполняются отдельным ipset worker.
    printf '%s\n' "${line}" | grep -Eq '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}' && continue
    host=$(printf '%s\n' "${line}" | sed 's/\*//g;')
    printf 'ipset=/%s/%s\n' "${host}" "${IPSET_TABLE_NAME}" >>"${destination_file}" || return 1
    expected=$((expected + 1))
  done <"${source_file}" || return 1

  created=$(grep -c '^ipset=/' "${destination_file}" 2>/dev/null || true)
  [ "${expected}" -eq "${created}" ]
}

dnsmasq__render_list "${host_list}" "${ipset_file}"
