#!/bin/sh

. /opt/apps/mors/bin/libs/telemetry_runtime
telemetry_runtime__pin_production
. /opt/apps/mors/bin/libs/main
. /opt/apps/mors/bin/libs/vpn
. /opt/apps/mors/bin/libs/vless
. /opt/apps/mors/bin/libs/lifecycle
. /opt/apps/mors/bin/libs/lifecycle_state
. /opt/apps/mors/bin/libs/lifecycle_snapshot
. /opt/apps/mors/bin/libs/runtime_lock
. /opt/apps/mors/bin/libs/telemetry_upgrade
. /opt/apps/mors/bin/libs/upgrade_artifact

MORS_RELEASE_API=${MORS_RELEASE_API:-https://api.github.com/repos/ivni/mors/releases/latest}
MORS_UPDATE_CACHE=${MORS_UPDATE_CACHE:-/opt/packages/mors-lifecycle}
MORS_UPDATE_RUNTIME_LOCK_WAIT=${MORS_UPDATE_RUNTIME_LOCK_WAIT:-60}

upgrade__usage() {
	cat <<'EOF'
Использование:
  mors update check [--json]
  mors update apply IPK --rollback-ipk PREVIOUS_IPK --yes
  mors rollback IPK --rollback-ipk CURRENT_IPK --yes

IPK и PREVIOUS_IPK должны иметь соседний файл с суффиксом .sha256.
EOF
}

upgrade__check() {
	local json latest current
	json=${1:-false}
	latest=$(curl -fsSL "${MORS_RELEASE_API}" | jq -er '.tag_name') || {
		error 'Не удалось получить сведения о последнем релизе Mors.'
		return 2
	}
	current=$(opkg status mors 2>/dev/null | awk -F': ' '/^Version:/{print $2; exit}')
	if [ "${json}" = true ]; then
		jq -n --arg current "${current}" --arg latest "${latest}" \
			'{schema_version: 1, command: "update check", current: $current, latest: $latest}'
	else
		echo "Установлено: ${current:-не определено}"
		echo "Последний релиз: ${latest}"
	fi
}

upgrade__verify_artifact() {
	local artifact=${1}
	[ -r "${artifact}" ] || {
		error "IPK не найден: ${artifact}."
		return 1
	}
	[ -r "${artifact}.sha256" ] || {
		error "Отсутствует digest: ${artifact}.sha256."
		return 1
	}
	upgrade_artifact__verified_digest "${artifact}" >/dev/null || {
		error "SHA-256 не совпадает для ${artifact}."
		return 1
	}
}

upgrade__reload_installed_runtime() {
	# opkg has replaced /opt/apps/mors. Reload functions before migrations,
	# verification or rollback so the installed package validates itself.
	if [ -r /opt/apps/mors/bin/libs/telemetry_runtime ]; then
		. /opt/apps/mors/bin/libs/telemetry_runtime || return 1
		telemetry_runtime__pin_production || return 1
	fi
	. /opt/apps/mors/bin/libs/main || return 1
	. /opt/apps/mors/bin/libs/vpn || return 1
	. /opt/apps/mors/bin/libs/vless || return 1
	. /opt/apps/mors/bin/main/setup || return 1
	if [ -r /opt/apps/mors/bin/libs/telemetry_upgrade ]; then
		. /opt/apps/mors/bin/libs/telemetry_upgrade || return 1
	fi
	if [ -r /opt/apps/mors/bin/libs/upgrade_artifact ]; then
		. /opt/apps/mors/bin/libs/upgrade_artifact || return 1
	fi
}

upgrade__load_committed_plan() {
	MORS_SETUP_INTERFACE_CLI=$(get_config_value INFACE_CLI)
	MORS_SETUP_INTERFACE_ENTWARE=$(get_config_value INFACE_ENT)
	[ -n "${MORS_SETUP_INTERFACE_CLI}" ] && [ -n "${MORS_SETUP_INTERFACE_ENTWARE}" ] || return 1
	if has_adguard_enable; then
		MORS_SETUP_DNS_BACKEND=adguard
	else
		MORS_SETUP_DNS_BACKEND=dnscrypt
	fi
	export MORS_SETUP_INTERFACE_CLI MORS_SETUP_INTERFACE_ENTWARE MORS_SETUP_DNS_BACKEND
}

upgrade__run_migrations() {
	local active_id legacy_backup
	if [ -f "${VLESS_REGISTRY_FILE}" ]; then
		vless_store__ensure || return 1
		active_id=$(vless_runtime__active_id)
		vless_domain__apply_generated "${active_id}" false || return 1
	elif [ -f "${VLESS_CONFIG_FILE}" ]; then
		legacy_backup=${VLESS_CONFIG_FILE}.legacy-1.1.9
		[ ! -e "${legacy_backup}" ] || return 1
		mv -f "${VLESS_CONFIG_FILE}" "${legacy_backup}" || return 1
		vless_store__ensure || return 1
		vless_domain__apply_generated '' false || return 1
	fi
}

upgrade__install_artifact() {
	local operation artifact
	operation=${1}
	artifact=${2}
	case "${operation}" in
		upgrade) opkg install "${artifact}" ;;
		rollback) opkg install --force-downgrade "${artifact}" ;;
		*) return 64 ;;
	esac
}

upgrade__restart_and_verify() {
	upgrade__load_committed_plan || return 1
	setup__activate_core_hooks || return 1
	(
		MORS_LIFECYCLE_APPLY=true
		export MORS_LIFECYCLE_APPLY
		cmd_mors_init no
	) >/dev/null 2>&1 || return 1
	telemetry_upgrade__restore_target "${MORS_UPDATE_TARGET_TELEMETRY}" || return 1
	lifecycle_transaction__phase verifying || return 1
	/opt/bin/mors version >/dev/null 2>&1 || return 1
	setup__verify_committed
}

upgrade__verify_passive_runtime() {
	/opt/bin/mors version >/dev/null 2>&1 || return 1
	opkg status mors 2>/dev/null | grep -q '^Status: install .* installed$' || return 1
	setup__verify_runtime_removed
}

upgrade__verify_unconfigured() {
	[ "$(lifecycle_state__read)" = unconfigured ] || return 1
	upgrade__verify_passive_runtime
}

upgrade__parse_apply() {
	local argument
	MORS_UPDATE_ARTIFACT=''
	MORS_UPDATE_ROLLBACK=''
	MORS_UPDATE_CONFIRMED=false
	while [ "$#" -gt 0 ]; do
		argument=$1
		case "${argument}" in
			--yes) MORS_UPDATE_CONFIRMED=true ;;
			--rollback-ipk)
				shift
				[ "$#" -gt 0 ] || return 64
				MORS_UPDATE_ROLLBACK=$1
				;;
			-*) return 64 ;;
			*) [ -z "${MORS_UPDATE_ARTIFACT}" ] || return 64; MORS_UPDATE_ARTIFACT=${argument} ;;
		esac
		shift
	done
	[ -n "${MORS_UPDATE_ARTIFACT}" ] || return 64
	[ -n "${MORS_UPDATE_ROLLBACK}" ] || return 64
	[ "${MORS_UPDATE_CONFIRMED}" = true ] || return 64
}

upgrade__rollback_failed_apply() {
	local result previous_state
	previous_state=$(jq -er '.previous_state' "$(lifecycle_transaction__journal_file)" 2>/dev/null) || return 1
	lifecycle_transaction__phase rolling_back || return 1
	opkg install --force-downgrade "${MORS_UPDATE_ROLLBACK}" >/dev/null 2>&1 || return 1
	upgrade__reload_installed_runtime || return 1
	(
		MORS_LIFECYCLE_APPLY=true
		export MORS_LIFECYCLE_APPLY
		lifecycle_snapshot__restore || exit 1
		if [ "${previous_state}" = ready ]; then
			upgrade__load_committed_plan || exit 1
			cmd_mors_init no || exit 1
			setup__verify_committed
		else
			upgrade__verify_passive_runtime
		fi
	) >/dev/null 2>&1 || return 1
	lifecycle_transaction__rollback_finish
	result=$?
	return "${result}"
}

upgrade__restore_pre_apply() {
	local previous_state
	previous_state=$(jq -er '.previous_state' "$(lifecycle_transaction__journal_file)" 2>/dev/null) || return 1
	lifecycle_transaction__phase rolling_back || return 1
	upgrade__reload_installed_runtime || return 1
	(
		MORS_LIFECYCLE_APPLY=true
		export MORS_LIFECYCLE_APPLY
		lifecycle_snapshot__restore || exit 1
		if [ "${previous_state}" = ready ]; then
			upgrade__load_committed_plan || exit 1
			cmd_mors_init no || exit 1
			setup__verify_committed
		else
			upgrade__verify_passive_runtime
		fi
	) >/dev/null 2>&1 || return 1
	lifecycle_transaction__rollback_finish
}

upgrade__apply_locked() {
	local operation state result rollback_result target_capability install_attempted=false snapshot
	local candidate_fingerprint rollback_fingerprint staged_candidate staged_rollback
	operation=${1}
	state=$(lifecycle_state__read) || return 4
	case "${state}" in ready|unconfigured) ;; *) return 3 ;; esac
	! lifecycle_state__has_active_marker || return 3
	candidate_fingerprint=$(upgrade_artifact__verified_digest "${MORS_UPDATE_ARTIFACT}") || return 64
	rollback_fingerprint=$(upgrade_artifact__verified_digest "${MORS_UPDATE_ROLLBACK}") || return 64

	runtime_mutation_lock__acquire_wait_or_explain "mors ${operation}" \
		"${MORS_UPDATE_RUNTIME_LOCK_WAIT}" || return $?
	lifecycle_transaction__begin "${operation}" "${state}" "${state}" >/dev/null || {
		result=$?
		runtime_mutation_lock__release >/dev/null 2>&1 || true
		return "${result}"
	}
	lifecycle_snapshot__capture || {
		result=$?
		lifecycle_transaction__rollback_finish >/dev/null 2>&1 || true
		runtime_mutation_lock__release >/dev/null 2>&1 || true
		return "${result}"
	}
	snapshot=$(lifecycle_transaction__snapshot_directory) || {
		lifecycle_transaction__rollback_finish >/dev/null 2>&1 || true
		runtime_mutation_lock__release >/dev/null 2>&1 || true
		return 1
	}
	staged_candidate=${snapshot}/candidate.ipk
	staged_rollback=${snapshot}/rollback.ipk
	if ! mkdir -p "${MORS_UPDATE_CACHE}" || \
		! upgrade_artifact__stage_pair "${MORS_UPDATE_ARTIFACT}" "${MORS_UPDATE_ROLLBACK}" \
			"${snapshot}" "${candidate_fingerprint}" "${rollback_fingerprint}"; then
		lifecycle_transaction__rollback_finish >/dev/null 2>&1 || \
			lifecycle_transaction__mark_recovery_required update_prepare_failed 2>/dev/null || true
		runtime_mutation_lock__release >/dev/null 2>&1 || true
		return 1
	fi
	target_capability=$(telemetry_upgrade__artifact_capability "${staged_candidate}" "${snapshot}") || {
		lifecycle_transaction__rollback_finish >/dev/null 2>&1 || true
		runtime_mutation_lock__release >/dev/null 2>&1 || true
		return 1
	}
	MORS_UPDATE_ARTIFACT=${staged_candidate}
	MORS_UPDATE_ROLLBACK=${staged_rollback}
	MORS_UPDATE_TARGET_TELEMETRY=${target_capability}
	export MORS_UPDATE_ARTIFACT MORS_UPDATE_ROLLBACK MORS_UPDATE_TARGET_TELEMETRY
	if ! lifecycle_transaction__phase prepared; then
		lifecycle_transaction__rollback_finish >/dev/null 2>&1 || \
			lifecycle_transaction__mark_recovery_required update_prepare_failed 2>/dev/null || true
		runtime_mutation_lock__release >/dev/null 2>&1 || true
		return 1
	fi

	if telemetry_upgrade__prepare_target "${MORS_UPDATE_TARGET_TELEMETRY}" && \
		lifecycle_transaction__phase applying; then
		install_attempted=true
	else
		result=1
	fi

	if [ "${result:-0}" -eq 0 ] && upgrade__install_artifact "${operation}" "${MORS_UPDATE_ARTIFACT}"; then
		upgrade__reload_installed_runtime || result=1
		if [ "${result:-0}" -eq 0 ] && [ "${state}" = ready ]; then
			upgrade__run_migrations || result=1
		fi
		if [ "${result:-0}" -eq 0 ]; then
			if [ "${state}" = ready ]; then
				upgrade__restart_and_verify || result=1
			else
				lifecycle_transaction__phase verifying || result=1
				[ "${result:-0}" -ne 0 ] || telemetry_upgrade__restore_target "${MORS_UPDATE_TARGET_TELEMETRY}" || result=1
				[ "${result:-0}" -ne 0 ] || upgrade__verify_unconfigured || result=1
			fi
		fi
		if [ "${result:-0}" -eq 0 ]; then
			lifecycle_transaction__finish || result=1
		fi
	elif [ "${result:-0}" -eq 0 ]; then
		result=1
	fi

	if [ "${result:-0}" -ne 0 ]; then
		if [ "${install_attempted}" = true ]; then
			upgrade__rollback_failed_apply || rollback_result=$?
		else
			upgrade__restore_pre_apply || rollback_result=$?
		fi
		if [ "${rollback_result:-0}" -eq 0 ]; then
			error 'Обновление не завершено. Предыдущая версия восстановлена.'
			result=2
		else
			lifecycle_transaction__mark_recovery_required update_rollback_failed 2>/dev/null || true
			error 'Не удалось восстановить предыдущую версию. Journal сохранён.'
			result=2
		fi
	fi
	runtime_mutation_lock__release || [ "${result:-0}" -ne 0 ] || result=1
	return "${result:-0}"
}

upgrade__apply() {
	local operation
	operation=${1}
	shift
	# Remove the public action name (`apply` or `rollback`) forwarded by CLI.
	shift
	upgrade__parse_apply "$@" || {
		upgrade__usage
		return 64
	}
	lifecycle__run_locked upgrade__apply_locked "${operation}"
}

upgrade__recover_locked() {
	local operation phase snapshot result
	operation=$(jq -er '.operation' "$(lifecycle_transaction__journal_file)" 2>/dev/null) || return 3
	phase=$(jq -er '.phase' "$(lifecycle_transaction__journal_file)" 2>/dev/null) || return 4
	case "${operation}" in
		upgrade|rollback) ;;
		*) return 3 ;;
	esac
	snapshot=$(lifecycle_transaction__snapshot_directory) || return 4
	runtime_mutation_lock__acquire_wait_or_explain 'mors update recover' \
		"${MORS_UPDATE_RUNTIME_LOCK_WAIT}" || return $?
	case "${phase}" in
		planning)
			lifecycle_transaction__rollback_finish
			result=$?
			;;
		prepared)
			upgrade__restore_pre_apply
			result=$?
			;;
		completed)
			lifecycle_transaction__reconcile_completed
			result=$?
			;;
		*)
			MORS_UPDATE_ROLLBACK=${snapshot}/rollback.ipk
			if upgrade__verify_artifact "${MORS_UPDATE_ROLLBACK}" && upgrade__rollback_failed_apply; then
				result=0
			else
				result=1
			fi
			;;
	esac
	runtime_mutation_lock__release || [ "${result}" -ne 0 ] || result=1
	[ "${result}" -eq 0 ] || lifecycle_transaction__mark_recovery_required update_recovery_failed 2>/dev/null || true
	return "${result}"
}

upgrade__recover() {
	[ "${2:-}" = --yes ] || return 64
	lifecycle__run_locked upgrade__recover_locked
}

case "${1:-check}" in
	check)
		case "${2:-}" in
			'') upgrade__check false ;;
			--json) upgrade__check true ;;
			*) upgrade__usage; exit 64 ;;
		esac
		;;
	apply) upgrade__apply upgrade "$@" ;;
	rollback) upgrade__apply rollback "$@" ;;
	recover) upgrade__recover "$@" ;;
	*) upgrade__usage; exit 64 ;;
esac
