setup_print_welcome(){

	[ -n "${APP_RELEASE}" ] && full_version="${APP_VERSION} ${APP_RELEASE}" || full_version="${APP_VERSION}"
	welcome="Установка пакета ${GREEN}МОРС${NOCL} версии ${GREEN}${full_version}${NOCL}"
	echo -e "${welcome}"
	print_line

	log_in_file "${welcome}"
	log_in_file line
	log_in_file "Начало установки: $(date "${DATE_FORMAT}")"
	log_in_file line
}
setup_adguard(){
	case "${MORS_SETUP_DNS_BACKEND:-}" in
		adguard)
			setup_plan__adguard_available || return 1
			ANSWER_AGH=y
			adguardhome_setup || return 1
			"${ADGUARDHOME_DEMON}" restart >/dev/null 2>&1 || return 1
			log_in_file 'Существующий AdGuard Home настроен как основной DNS сервер.'
			;;
		dnscrypt)
			ANSWER_AGH=n
			if [ -x "${ADGUARDHOME_DEMON}" ] && \
				"${ADGUARDHOME_DEMON}" status 2>/dev/null | grep -q alive; then
				"${ADGUARDHOME_DEMON}" stop >/dev/null 2>&1 || return 1
			fi
			if [ -r "${ADGUARDHOME_CONFIG}" ]; then
				cp -p "${ADGUARDHOME_CONFIG}" "${MORS_BACKUP_PATH}/AdGuardHome.yaml" || return 1
			fi
			log_in_file 'AdGuard Home не выбран; используется dnsmasq + dnscrypt-proxy2.'
			;;
		*) return 1 ;;
	esac
}

#
#	Функция восстановления архивных файлов конфигурации пакета
#	$1 - архивный файл конфигурации
#	$2 - файл в который необходимо восстановить (назначение)
#	$3 - описание файла в родительном падеже при склонении слова файл - "чего"?, например, "защищенного списка"
#
restore_backup(){

	backup_file="${1}"
	dest_file="${2}"
	description="${3}"

#	Проверяем сохраняли ли ранее файлы конфигурации в архивную папку?
	if [ -f "${backup_file}" ]; then
#		warning "Обнаружен архивный файл ${description}..."
		log_in_file "Файл ${description} ВОССТАНОВЛЕН из архива."
		ready "Файл ${description} ${BLUE}восстановлен${NOCL}"
		if mv -f "${backup_file}" "${dest_file}" ; then
			when_ok "УСПЕШНО"
		else
			when_bad "ОШИБКА"
			log_in_file "ОШИБКА: ${description} не восстановлен."
			exit 1
		fi
#		print_line
	else
#		Если нет архивной копии файла, то в случае наличия файла
#		по умолчанию в настройках пакета - восстанавливаем его
		file_name=$(basename "${dest_file}")
		mors_config_path=/opt/apps/mors/etc/conf

		if [ -f "${mors_config_path}/${file_name}" ]; then
#			warning "Архивный файл ${description} не обнаружен."
			ready "Копируем файл ${description} по умолчанию"
			if cp -f "${mors_config_path}/${file_name}" "${dest_file}" &>/dev/null ; then
				log_in_file "УСТАНОВЛЕН файл ${description} ПО УМОЛЧАНИЮ."
				when_ok "УСПЕШНО"
			else
				when_bad "ОШИБКА"
				log_in_file "ОШИБКА: файл ${description} по умолчанию не восстановлен."
				exit 1
			fi
#			print_line
		fi
	fi

}



# Функция временной остановки работы пакета
cmd_pause_mors(){

	ready "Временно приостановливаем работу Морса..."
	{
		ip4__flush &> /dev/null

		# Архивируем файлы механизма ndm
		[ -f /opt/etc/ndm/iflayerchanged.d/100-mors-vpn ] && {
			mv /opt/etc/ndm/iflayerchanged.d/100-mors-vpn ${MORS_BACKUP_PATH}/100-mors-vpn-layer
		}
		[ -f /opt/etc/ndm/netfilter.d/100-proxy-redirect ] && {
			mv /opt/etc/ndm/netfilter.d/100-proxy-redirect ${MORS_BACKUP_PATH}/100-proxy-redirect
		}
		[ -f /opt/etc/ndm/netfilter.d/100-vpn-mark ] && {
			mv /opt/etc/ndm/netfilter.d/100-vpn-mark ${MORS_BACKUP_PATH}/100-vpn-mark
		}
	} &> /dev/null && when_ok "УСПЕШНО" || when_bad "C ОШИБКАМИ"
}

restart_all_services(){

	if cmd_adguardhome_status | grep -qE "(ВКЛЮЧЕН|ОТКЛЮЧЕН)" ; then
		service_action dnsmasq stop
		service_action shadowsocks stop
		service_action adguardhome restart
	else
		if has_ssr_enable ; then
			service_action xray stop
			service_action shadowsocks restart
		else
			service_action xray restart
			service_action dnsmasq restart
			get_dns_crypt_status | grep -q "on" && {
				service_action dnscrypt-proxy2 restart
			}
		fi

	fi



}
# Функция восстановления архивных файлов конфигурации пакета
cmd_unpause_mors(){

	ready "Восстанавливаем работу Морса после паузы..."
	{
		#  Восстанавливаем из архива файлы механизма ndm
		[ -f ${MORS_BACKUP_PATH}/100-mors-vpn-layer ] && {
			mv ${MORS_BACKUP_PATH}/100-mors-vpn-layer /opt/etc/ndm/iflayerchanged.d/100-mors-vpn
		}
		[ -f ${MORS_BACKUP_PATH}/100-proxy-redirect ] && {
			mv ${MORS_BACKUP_PATH}/100-proxy-redirect /opt/etc/ndm/netfilter.d/100-proxy-redirect
		}
		[ -f ${MORS_BACKUP_PATH}/100-vpn-mark ] && {
			mv ${MORS_BACKUP_PATH}/100-vpn-mark /opt/etc/ndm/netfilter.d/100-vpn-mark
		}

		cmd_mors_init
		restart_all_services

	} &> /dev/null && when_ok "УСПЕШНО" || when_bad "C ОШИБКАМИ"

}


#------------------------------------------------------
# 	ВОССТАНАВЛИВАЕМ СОСТОЯНИЕ AdGuardHome,
# 	КОТОРОЕ БЫЛО ПЕРЕД УСТАНОВКОЙ ПАКЕТА МОРС
#------------------------------------------------------
restore_adguard(){

	agh_service=/opt/etc/init.d/S99adguardhome
	ready "Восстанавливаем службу AdGuardHome"
	if [ -f "${MORS_BACKUP_PATH}/S99adguardhome.origin" ]; then

		cp "${MORS_BACKUP_PATH}/S99adguardhome.origin" "${agh_service}"
		[ -f /opt/etc/AdGuardHome/AdGuardHome.yaml ] && \
			cp /opt/etc/AdGuardHome/AdGuardHome.yaml /opt/bin/AdGuardHome.yaml
	fi

	if /opt/etc/init.d/S99adguardhome status | grep -q "alive" ; then
		sed -i '/case/,/esac/ s/^\(.*\)/#\1/; /\*)/,/;;/ s/#\(.*rc.func\)/\1/' "${agh_service}"
		"${agh_service}" restart &> /dev/null
	fi
	[ $? = 0 ] && when_ok "УСПЕШНО" || when_bad "ОШИБКА"
}

#------------------------------------------------------
# 	ОСТАНАВЛИВАЕМ dnsmasq
#------------------------------------------------------
stop_dnsmasq(){

	if /opt/etc/init.d/S56dnsmasq status | grep -q "alive"; then
		ready "Останавливаем службу dnsmasq "
		service_action dnsmasq stop &> /dev/null
		[ $? = 0 ] && when_ok "УСПЕШНО" || when_bad "ОШИБКА"
	fi
	ready "Архивируем файл службы S56dnsmasq"
	mv /opt/etc/init.d/S56dnsmasq /opt/etc/init.d/K56dnsmasq
	[ $? = 0 ] && when_ok "УСПЕШНО" || when_bad "ОШИБКА"
	print_line
	warning "Файл сохранен, как /opt/etc/init.d/K56dnsmasq"
	print_line
}


#------------------------------------------------------
# 	ОСТАНАВЛИВАЕМ dnscrypt-proxy2
#------------------------------------------------------
stop_crypt(){
	if /opt/etc/init.d/S09dnscrypt-proxy2 status | grep -q "alive"; then
		ready "Останавливаем службу dnscrypt-proxy2 "
		service_action dnscrypt-proxy2 stop &> /dev/null
		[ $? = 0 ] && when_ok "УСПЕШНО" || when_bad "ОШИБКА"
	fi

	ready "Архивируем файл службы S09dnscrypt-proxy2"
	mv /opt/etc/init.d/S09dnscrypt-proxy2 /opt/etc/init.d/K09dnscrypt-proxy2
	[ $? = 0 ] && when_ok "УСПЕШНО" || when_bad "ОШИБКА"
	print_line
	warning "Файл сохранен, как /opt/etc/init.d/K09dnscrypt-proxy2"
}

# восставившем архивные копии файлов конфигурации
restore_backups(){
	restore_backup "${MORS_LIST_FILE_BACKUP}" "${MORS_LIST_FILE}" "защищенного списка"
	restore_backup "${MORS_CONFIG_BACKUP}" "${MORS_CONF_FILE}" "конфигурации пакета Морс"

	restore_backup "${ADGUARDHOME_CONFIG_BACKUP}" "${ADGUARDHOME_CONFIG}" "конфигурации AdGuardHome"
	restore_backup "${ADGUARD_IPSET_FILE_BACKUP}" "${ADGUARD_IPSET_FILE}" "списка ipset для AdGuardHome"

	restore_backup "${SHADOWSOCKS_CONF_BACKUP}" "${SHADOWSOCKS_CONF}" "конфигурации Shadowsocks"

	restore_backup "${DNSMASQ_CONFIG_BACKUP}" "${DNSMASQ_CONFIG}" "конфигурации dnsmasq"
	restore_backup "${DNSMASQ_IPSET_HOSTS_BACKUP}" "${DNSMASQ_IPSET_HOSTS}" "списка ipset для dnsmasq"

	restore_backup "${VLESS_CONFIG_FILE_BACKUP}" "${VLESS_CONFIG_FILE}" "конфигурации xray vless"
	if [ -d "${MORS_BACKUP_PATH}/vless-store" ]; then
		ready "Хранилище управляемых VLESS-соединений восстановлено"
		local restore_candidate="${VLESS_STORE_ROOT}.restore-candidate"
		local previous_store="${VLESS_STORE_ROOT}.previous"
		local had_live_store=false
		if [ -d "${previous_store}" ]; then
			if [ ! -d "${VLESS_STORE_ROOT}" ]; then
				mv -f "${previous_store}" "${VLESS_STORE_ROOT}" || return 1
			else
				rm -rf "${previous_store}"
			fi
		fi
		rm -rf "${restore_candidate}"
		mkdir -p "$(dirname "${VLESS_STORE_ROOT}")" "${restore_candidate}"
		if cp -pR "${MORS_BACKUP_PATH}/vless-store/." "${restore_candidate}/" && \
			vless_store__validate_tree "${restore_candidate}"; then
			if [ -d "${VLESS_STORE_ROOT}" ]; then
				mv -f "${VLESS_STORE_ROOT}" "${previous_store}" || { rm -rf "${restore_candidate}"; return 1; }
				had_live_store=true
			fi
			if [ -e "${VLESS_STORE_ROOT}" ] || \
				! mv -f "${restore_candidate}" "${VLESS_STORE_ROOT}" || \
				! vless_store__validate_tree "${VLESS_STORE_ROOT}"; then
				rm -rf "${VLESS_STORE_ROOT}" "${restore_candidate}"
				if [ "${had_live_store}" = true ] && ! mv -f "${previous_store}" "${VLESS_STORE_ROOT}"; then
					error "Критическая ошибка: не удалось вернуть прежнее VLESS-хранилище."
				fi
				when_bad "ОШИБКА"
				return 1
			fi
			rm -rf "${previous_store}"
			chmod 700 "${VLESS_STORE_ROOT}" "${VLESS_CONNECTIONS_DIR}" 2>/dev/null || true
			find "${VLESS_STORE_ROOT}" -type f -exec chmod 600 {} \;
			when_ok "УСПЕШНО"
		else
			rm -rf "${restore_candidate}"
			when_bad "ОШИБКА"
			return 1
		fi
	fi

	restore_backup "${DNSCRYPT_CONFIG_BACKUP}" "${DNSCRYPT_CONFIG}" "конфигурации dnscrypt_proxy2"
	restore_backup "${ADBLOCK_LIST_EXCEPTION_BACKUP}" "${ADBLOCK_LIST_EXCEPTION}" "списка хостов-исключений для блокировки рекламы"
	restore_backup "${ADBLOCK_HOSTS_FILE_BACKUP}" "${ADBLOCK_HOSTS_FILE}" "списка хостов для блокировки рекламы"
	restore_backup "${ADBLOCK_SOURCES_LIST_BACKUP}" "${ADBLOCK_SOURCES_LIST}" "списка источников хостов для блокировки рекламы"
#	restore_backup "${}" "${}" ""
	print_line
}


# Сохраняем все значимые файлы конфигурации пакета Морс
save_backups(){
	backup_copy "${MORS_CONF_FILE}" "${MORS_CONFIG_BACKUP}"
	backup_copy "${MORS_LIST_FILE}" "${MORS_LIST_FILE_BACKUP}"

	backup_copy "${ADGUARDHOME_CONFIG}" "${ADGUARDHOME_CONFIG_BACKUP}"
	backup_copy "${ADGUARD_IPSET_FILE}" "${ADGUARD_IPSET_FILE_BACKUP}"

	backup_copy "${SHADOWSOCKS_CONF}" "${SHADOWSOCKS_CONF_BACKUP}"

	backup_copy "${DNSMASQ_CONFIG}" "${DNSMASQ_CONFIG_BACKUP}"
	backup_copy "${DNSMASQ_IPSET_HOSTS}" "${DNSMASQ_IPSET_HOSTS_BACKUP}"

	backup_copy "${VLESS_CONFIG_FILE}" "${VLESS_CONFIG_FILE_BACKUP}"
	if [ -d "${VLESS_STORE_ROOT}" ]; then
		local backup_candidate="${MORS_BACKUP_PATH}/vless-store.candidate"
		local previous_backup="${MORS_BACKUP_PATH}/vless-store.previous"
		local had_previous_backup=false
		if [ -d "${previous_backup}" ]; then
			if [ ! -d "${MORS_BACKUP_PATH}/vless-store" ]; then
				mv -f "${previous_backup}" "${MORS_BACKUP_PATH}/vless-store" || return 1
			else
				rm -rf "${previous_backup}"
			fi
		fi
		rm -rf "${backup_candidate}"
		mkdir -p "${backup_candidate}"
		if ! cp -pR "${VLESS_STORE_ROOT}/." "${backup_candidate}/" || \
			! vless_store__validate_tree "${backup_candidate}"; then
			rm -rf "${backup_candidate}"
			error "Не удалось создать проверенную резервную копию VLESS. Обновление остановлено."
			return 1
		fi
		if [ -d "${MORS_BACKUP_PATH}/vless-store" ]; then
			mv -f "${MORS_BACKUP_PATH}/vless-store" "${previous_backup}" || { rm -rf "${backup_candidate}"; return 1; }
			had_previous_backup=true
		fi
		if [ -e "${MORS_BACKUP_PATH}/vless-store" ] || \
			! mv -f "${backup_candidate}" "${MORS_BACKUP_PATH}/vless-store" || \
			! vless_store__validate_tree "${MORS_BACKUP_PATH}/vless-store"; then
			rm -rf "${MORS_BACKUP_PATH}/vless-store" "${backup_candidate}"
			if [ "${had_previous_backup}" = true ] && ! mv -f "${previous_backup}" "${MORS_BACKUP_PATH}/vless-store"; then
				error "Критическая ошибка: прежняя VLESS-копия осталась в ${previous_backup}."
			fi
			return 1
		fi
		rm -rf "${previous_backup}"
	fi

	backup_copy "${DNSCRYPT_CONFIG}" "${DNSCRYPT_CONFIG_BACKUP}"

	backup_copy "${ADBLOCK_HOSTS_FILE}" "${ADBLOCK_HOSTS_FILE_BACKUP}"
	backup_copy "${ADBLOCK_SOURCES_LIST}" "${ADBLOCK_SOURCES_LIST_BACKUP}"
	backup_copy "${ADBLOCK_LIST_EXCEPTION}" "${ADBLOCK_LIST_EXCEPTION_BACKUP}"

#	backup_copy "${}" "${}"
}

list__backup() {
	if [ -z "${1}" ] ; then
		if [ -f "${MORS_LIST_FILE}" ] ; then
			list__backup "${MORS_LIST_FILE}"
		elif [ -f "${MORS_LIST_FILE_BACKUP}" ] ; then
			list__backup "${MORS_LIST_FILE_BACKUP}"
		fi

		return
	fi
	local source_file="${1}"

	local backup_path="${HOME}/mors"
	local backup_filename
	backup_filename=$( date '+%y-%m-%d' )
	backup_filename="list_${backup_filename}.txt"
	local backup2_file="${backup_path}2_${backup_filename}"

	# проверка, что файл старого формата
	# -n не перезаписываем, если сегодняшний бекап уже есть
	if grep -qF '*' "${source_file}" ; then
		local backup1_file="${backup_path}1_${backup_filename}"
		if [ -f "${backup1_file}" ] ; then
			return
		fi

		echo "Резервная копия списка старого формата в ${backup1_file}"
		cp "${source_file}" "${backup1_file}"

		if ! [ -f "${backup2_file}" ] ; then
			echo "Преобразуем в новый формат в ${backup2_file}"
			sed 's/\*\.//g;s/\*//g' "${source_file}" >"${backup2_file}"
		fi
	elif ! [ -f "${backup2_file}" ] ; then
		echo "Резервная копия списка в ${backup2_file}"
		cp "${source_file}" "${backup2_file}"
	fi
}

#------------------------------------------------------
# УДАЛЕНИЕ ФАЙЛОВ
#------------------------------------------------------
rm_dir()(  [ -d "${1}" ] && rm -rf "${1}" || true)
rm_file()( [ -e "${1}" ] || [ -L "${1}" ] && rm -f "${1}"  || true )

#------------------------------------------------------
# УДАЛЕНИЕ ФАЙЛОВ КОНФИГУРАЦИИ
#------------------------------------------------------
rm_package_files() {
	local full=${1:-no}

	if [ "${full}" = full ] ; then
		ready 'Удаляем архивные копии пакета Морс' && {
			# Активный lifecycle-lock удаляет только owner-checked release.
			find /opt ! -path '/opt/packages/*' ! -path '/opt/lib/opkg/*' ! -path "${HOME}/*" \
			  ! -path "${MORS_LIFECYCLE_LOCK_DIR}" ! -path "${MORS_LIFECYCLE_LOCK_DIR}/*" \
			  -name '*mors*' ! -regex '.*/mors[a-zA-Z].*' \
			  -exec rm -rf {} +

			rm_file /opt/etc/inface_equals
			rm_file /opt/etc/mors.conf
			rm_file /opt/etc/mors.list

			rm_dir /opt/etc/.mors

			# корректно ли так поступать вместо opkg remove?
			rm_file /opt/etc/init.d/S22shadowsocks
		} && when_ok || when_bad
	fi
	ready 'Удаляем файлы пакета Морс' && {
		rm_file /opt/etc/ndm/netfilter.d/100-dns-local
		rm_file /opt/etc/ndm/netfilter.d/100-vpn-mark
		rm_file /opt/etc/ndm/netfilter.d/100-proxy-redirect

		rm_file /opt/etc/ndm/ifcreated.d/mors-iface-add
		rm_file /opt/etc/ndm/ifdestroyed.d/mors-iface-del
		rm_file /opt/etc/ndm/iflayerchanged.d/100-mors-vpn
		# Миграционная очистка файлов версий до KeeneticOS 5.
		rm_file /opt/etc/ndm/ifstatechanged.d/100-mors-vpn
		rm_file /opt/etc/ndm/ifstatechanged.d/100-unblock-vpn

		rm_file /opt/etc/ndm/fs.d/15-mors-start.sh
		rm_file /opt/etc/cron.5mins/check_vpn
		rm_file /opt/etc/cron.5mins/vless-watchdog
		rm_file /opt/etc/init.d/S25mors-vless
		rm_dir /opt/var/run/mors/vless

		rm_file /opt/etc/dnsmasq.d/mors.dnsmasq
		rm_dir /opt/etc/adblock
		rm_dir /opt/tmp/adblock

		rm_file /opt/bin/mors
		rm_dir /opt/apps/mors
	} && when_ok || when_bad
}

rm_previous_version_files() {
	#rm_file /opt/etc/ndm/netfilter.d/100-dns-local
	# текущие, создадутся при включении соединения
	rm_file /opt/etc/ndm/netfilter.d/100-vpn-mark
	rm_file /opt/etc/ndm/netfilter.d/100-proxy-redirect

	# текущие, создадутся в cmd_install позже
	rm_file /opt/etc/ndm/ifcreated.d/mors-iface-add
	rm_file /opt/etc/ndm/ifdestroyed.d/mors-iface-del
	rm_file /opt/etc/ndm/iflayerchanged.d/100-mors-vpn
	# Миграционная очистка файлов версий до KeeneticOS 5.
	rm_file /opt/etc/ndm/ifstatechanged.d/100-mors-vpn
	rm_file /opt/etc/ndm/ifstatechanged.d/100-unblock-vpn
	# исторический
	rm_file /opt/etc/ndm/wan.d/internet-up

	# исторические
	rm_file /opt/etc/ndm/fs.d/100-vpn
	rm_file /opt/etc/ndm/fs.d/100-ipset

	# текущий, создастся при включении соединения
	rm_file /opt/etc/cron.5mins/check_vpn
	rm_file /opt/etc/cron.5mins/vless-watchdog
	# исторический
	rm_file /opt/etc/cron.5mins/ipset.mors
	# оптимизированные
	rm_file /opt/etc/cron.hourly/ipset.mors
	rm_file /opt/etc/cron.daily/ipset.mors

	# текущие, создадутся позже
	rm_file /opt/etc/dnsmasq.d/mors.dnsmasq
	rm_dir /opt/etc/adblock
	rm_dir /opt/tmp/adblock
	# исторические
	rm_file /opt/etc/ads_exception.list
	rm_file /opt/etc/hosts.list
	rm_dir /opt/etc/.backup

	# Архивы оставляем: при update/rollback uninstall сохраняет туда пользовательские
	# конфиги, а cmd_install ниже восстанавливает их через restore_backups.
	# Полное удаление архивов выполняется только через rm_package_files full.
}

clear_previous_version_net_rules() {
	ip4__rule__delete_mark_to_table
	ip4__route__flush_table

	ip4__chain__delete_jump 'nat'    'MORS_DNS'
	ip4__chain__delete      'nat'    'MORS_DNS'

	#24-12-21 7791b886b2f233a71447c985ec8dfe57c53cab40
	ip4__chain__delete_jump 'mangle' 'MORS_MARK'
	ip4__chain__delete      'mangle' 'MORS_MARK'
	#24-11-27 7bda08de3472da3a8e6f17903f65ff10c899ceb7
	ip4__chain__delete_jump 'mangle' 'MORS_MARK_TO_TABLE'
	ip4__chain__delete      'mangle' 'MORS_MARK_TO_TABLE'
	ip4__chain__delete_jump 'nat'    'MORS_DNAT_TO_PORT'
	ip4__chain__delete      'nat'    'MORS_DNAT_TO_PORT'
	#24-11-26 10c31fcf4c1a9b201b7e21946a9ee055a82a9183
	ip4__chain__delete_jump 'mangle' 'MORS_VPN_FAST'
	ip4__chain__delete      'mangle' 'MORS_VPN_FAST'
	#24-11-26 df8b36e2e64ae3844073518ce9a6db64c8bb7efd
	ip4__chain__delete_jump 'nat'    'MORS_PROXY_TCP'
	ip4__chain__delete      'nat'    'MORS_PROXY_TCP'
	ip4__chain__delete_jump 'nat'    'MORS_PROXY_UDP'
	ip4__chain__delete      'nat'    'MORS_PROXY_UDP'
	#24-11-26 0e67e8aa45ba287c02a1e270f9f56afe76b72b2c
	ip4__chain__delete_jump 'mangle' 'MORS_VPN'
	ip4__chain__delete      'mangle' 'MORS_VPN'
	# давно
	ip4__chain__delete_jump 'mangle' 'VPNREDIR'
	ip4__chain__delete      'mangle' 'VPNREDIR'
	ip4__chain__delete_jump 'nat'    'SHADOWSOCKS'
	ip4__chain__delete      'nat'    'SHADOWSOCKS'
	ip4__chain__delete_jump 'nat'    'SHADOWSOCKS_UDP_MARK'
	ip4__chain__delete      'nat'    'SHADOWSOCKS_UDP_MARK'

	# ss доцепочечных времён
	iptables__delete_rules 'nat' 'MORS_LIST'
	iptables__delete_rules 'nat' 'mors_ipset'
	iptables__delete_rules 'nat' 'mors'
	iptables__delete_rules 'nat' 'unblock'

	# dns доцепочечных времён
	iptables__delete_rules 'nat' '--dport 9753 -j DNAT'
	iptables__delete_rules 'nat' '--dport 53 -j DNAT'

	#24-12-15 b3dec7293bb8e3de59cce200b4e8dc8d4b9f3dac
	ip4__ipset__destroy 'MORS_DESTINATION_EXCLUDED'
	#24-11-26 5efb5035c33fffb18c5d17cd7c56e453b0b64ac8
	ip4__ipset__destroy 'MORS_RESERVED'

	#ToDo: найти почему вываливаются с ошибкой
	#24-11-29 0dabaa19b8dc788d56650b20092dec4a9dce1acc
	ip4__ipset__destroy 'MORS_LIST'
	#24-11-09 fb1f8cb5755dd4c7b683b314096ccf903ee05525
	ip4__ipset__destroy 'mors_ipset'
	#24-09-07 f78979503e9866f2dca3770455b241c3db8f850d
	ip4__ipset__destroy 'mors'
	# давно
	ip4__ipset__destroy 'unblock'
}

setup__cmd_install_unlocked(){

#	Если режим обновления, то не спрашиваем про выбор соединения,
#	а просто берем его из файла конфигурации Морса
	setup_require_supported_os || return 1
	setup_plan__validate_selected || {
		error 'Выбранный setup plan больше не соответствует состоянию роутера.'
		return 1
	}
	setup__prepare_selected_interface || return $?
	setup_plan__validate_selected || {
		error 'Подготовленный VPN-интерфейс не соответствует setup plan.'
		return 1
	}
	setup__record_selected_interface_mapping || {
		error 'Не удалось сохранить соответствие выбранного VPN-интерфейса.'
		return 1
	}

	log_warning 'Установка пакета МОРС начата...'

	list__backup

	ready 'Удаляем файлы предыдущих версий'
	rm_previous_version_files && when_ok || when_bad

	echo 'Очищаем сетевые правила предыдущих версий'
	clear_previous_version_net_rules

	# Стартуем ipset'ы, используемые DNS-серверами, до старта DNS.
	ip4__ipset__create_list

	# Обязательные пакеты принадлежат dependency graph opkg. Setup не меняет
	# их user/auto-installed ownership и не переустанавливает конфиги.
	for required_command in jq ipset iptables; do
		command -v "${required_command}" >/dev/null 2>&1 || {
			error "Отсутствует обязательная зависимость: ${required_command}. Переустановите пакет mors через opkg."
			return 1
		}
	done

	setup_print_welcome
	mkdir -p "${MORS_BACKUP_PATH}"
	cat /dev/null > "${INSTALL_LOG}"

	check_crypto_ssr_libs || warning 'Совместимая libmbedcrypto не найдена; Shadowsocks будет недоступен.'

	# Xray нужен только для VLESS: проблемы с ним не должны блокировать
	# настройку Mors для OpenVPN/WireGuard и других интерфейсов.
	xray_version_check || warning "VLESS будет недоступен до установки совместимой версии Xray."
	# Создаем ссылку на наш скрипт для запуска xray в /opt/etc/init.d
	[ -f "${XRAY_INIT}" ] || ln -s /opt/apps/mors/etc/init.d/S97xray ${XRAY_INIT}
	ln -sf /opt/apps/mors/etc/init.d/S25mors-vless "${VLESS_SUPERVISOR_INIT}"
	chmod +x "${VLESS_SUPERVISOR_INIT}"

	# Код отключения IPv6 не помогает
	#if [ "$(ipv6_status)" = 0 ]; then
	#	ipv6_inface_off "$(get_defaultgw_interface)"
	#fi
	# В mors debug dns сейчас есть подсказка по отключению DHCPv6 централизованно.
	# Также выводится в конце установки.
	# Но применять её или IPv6 отключать руками — решать пользователю,
	# т.к. с отключением IPv6 можно потерять некоторых провайдеров.

	local_ip=$(get_router_ip)
	set_config_value DNSMASQ_LISTEN_IP "${local_ip}"

	# Все решения получены и проверены до transaction begin. Apply не задаёт
	# вопросов и использует ровно тот интерфейс, который показан в плане.
	is_install_stage=install
	MORS_DEFER_SYSTEM_HOOKS=true
	export MORS_DEFER_SYSTEM_HOOKS
	switch_vpn_on "${MORS_SETUP_INTERFACE_ENTWARE}" "${MORS_SETUP_INTERFACE_CLI}" || return 1
	unset MORS_DEFER_SYSTEM_HOOKS
	log_in_file "$(cmd_vpn_status)"
	print_line
	#------------------------------------------------------
	# AdGuard Home
	#------------------------------------------------------
	setup_adguard || return 1

	#----------------------------------------------------------
	#
	# 	В случае, если установить AdGuard Home отказались
	# 	или не был обнаружен сервис AdGuard Home
	# 	AdGuard Home подменяет сразу несколько сервисов
	# 	таких как dnsmasq + dnscrypt_proxy2 + блокировка рекламы
	#
	#----------------------------------------------------------

	if [ "${ANSWER_AGH}" = n ]; then

		if [ -f "${ADGUARDHOME_DEMON}" ]; then
			if "${ADGUARDHOME_DEMON}" status | grep -q alive; then
				"${ADGUARDHOME_DEMON}" stop &> /dev/null
			fi
		fi

		#------------------------------------------------------
		# DNSMASQ
		#------------------------------------------------------
		dnsmasq_install 'install' || return 1
		#------------------------------------------------------
		# DNSCRYPT-PROXY2
		#------------------------------------------------------
		dns_crypt_install 'install' || return 1
		log_in_file "Шифрование DNS трафика (dnscrypt-proxy2) ВКЛЮЧЕНО."
		#------------------------------------------------------
		# Блокировка рекламы
		#------------------------------------------------------
		log_in_file "Блокировка рекламы НЕ УСТАНОВЛЕНА.."
		print_line
	#	fi
	fi

	# Подключаем библиотеку keen_api
	#source /opt/apps/mors/bin/libs/keen_api
	# Устанавливаем DNS роутера и порт по умолчанию
	#set_dns_router_server_ip "$(get_router_ip)" "${MAIN_DNS_PORT}"

	# Закрываем снаружи DNS порты для всех вншних сетей
	# deny_firewall_port "53" "tcp" "Морс: закрываем снаружи 53/TCP DNS порт"
	# deny_firewall_port "53" "udp" "Морс: закрываем снаружи 53/UDP DNS порт"
	# allow_firewall_local_net_to_port "53" "tcp" "Морс: разрешаем локальной сети обращения в 53/TCP DNS порт"
	# allow_firewall_local_net_to_port "53" "udp" "Морс: разрешаем локальной сети обращения в 53/UDP DNS порт"
	# # Устанавливаем вышесозданные правила на первое место в списке правил
	# set_firewall_order_for_rule "53" "tcp" "deny" "0"
	# set_firewall_order_for_rule "53" "udp" "deny" "0"
	# set_firewall_order_for_rule "53" "udp" "permit" "0"
	# set_firewall_order_for_rule "53" "udp" "permit" "0"
	# Записываем изменения в конфиг
	#save_system_configuration_by_api

	#------------------------------------------------------
	# 	Запускаем МОРС в работу
	#------------------------------------------------------
	setup__activate_core_hooks || return 1

	ready "Запускаем МОРС в работу"
	if cmd_mors_init &> /dev/null ; then
		when_ok "УСПЕШНО"
	else
		when_bad "ОШИБКА"
		ready "Пробуем перезапустить МОРС снова"
		if cmd_mors_init &> /dev/null ; then
			when_ok "УСПЕШНО"
		else
			when_bad "ОШИБКА"
			mess="Проблема при запуске МОРСа"
			log_in_file "ОШИБКА: ${mess}"
			exit 1
		fi
	fi

}

# WGET='/opt/bin/wget -q --no-check-certificate'
# Вы полняем команду отключения DNS провайдера без перезагрузки и выхода из сессии
# rci_post()($WGET -qO - --post-data="$1" localhost:79/rci/ > /dev/null 2>&1)


#------------------------------------------------------
#  Обрабатываем режим тестировщика
#  удаляем под ноль все запущенные службы
#------------------------------------------------------
all_services_rm_develop_mode() {

	if cmd_adguardhome_status | grep -q "ВКЛЮЧЕН" ; then
		ready "Останавливаем и удаляем службу AdGuardHome "
		{
			${ADGUARDHOME_DEMON} stop &> /dev/null
			rm_file /opt/etc/AdGuardHome/AdGuardHome.yaml
			opkg remove adguardhome-go --force-depends &> /dev/null
		} && when_ok "УСПЕШНО" || when_bad "ОШИБКА"

	else

		if has_ssr_enable ; then
			ready "Останавливаем службу Shadowsocks "
			{
				# Останавливаем сервер SSR
				/opt/etc/init.d/S22shadowsocks stop &> /dev/null
				rm_file /opt/etc/shadowsocks.json
				opkg remove shadowsocks-libev --force-depends &> /dev/null

			} && when_ok "УСПЕШНО" || when_bad "ОШИБКА"
		else
			ready "Останавливаем службу dnsmasq "
			{
				/opt/etc/init.d/S56dnsmasq stop &> /dev/null
				rm_file /opt/etc/dnsmasq.conf
				opkg remove dnsmasq --force-depends &> /dev/null
			} && when_ok "УСПЕШНО" || when_bad "ОШИБКА"

			ready "Останавливаем службу dnscrypt-proxy2 "
			{
				/opt/etc/init.d/S09dnscrypt-proxy2 stop &> /dev/null
				rm_file /opt/etc/dnscrypt-proxy.toml
				opkg remove dnscrypt-proxy2 --force-depends &> /dev/null
			} && when_ok "УСПЕШНО" || when_bad "ОШИБКА"
		fi
	fi
}



# ------------------------------------------------------------------------------------------
#
#	 Удаляет полностью пакет Морс с устройства
#	 $1 - тип удаления
#		<ПУСТО> - если без аргументов, то удаляем без удаления пакетов, но со всеми архивами
#	 	full - удаляем полностью со всеми ранее установленными пакетами и файлами архивов
#	 $2 - делаем ли запрос при удалении пакета о подтверждении удаления или нет
#	 		если аргумент yes - то вопрос задаем,
#	 		если иное - то пропускаем запрос на удаление пакета
#
# ------------------------------------------------------------------------------------------
setup__cmd_uninstall_unlocked() {

	rm_type=${1}; sure="${2}";
	answer_yes='y|Y|Yes|yes|YES|да|Да|ДА'
	[ -n "${APP_RELEASE}" ] && rel="-${APP_RELEASE}" || rel=''
	echo -e "Удаление пакета ${GREEN}МОРС™${NOCL} версии ${GREEN}${APP_VERSION}${rel}${NOCL}..."


	if [ -n "${rm_type}" ] && [[ "${rm_type}" =~ "${answer_yes}" ]] \
		|| [[ "${sure}" =~ "${answer_yes}" ]] ; then
		answer=y; sure=y
	else
		print_line
		answer=''; read_ynq_timer "Вы уверены в удалении пакета ?" answer N 12
		if [ "${answer}" = q ] ; then exit_q; print_line; exit 1; fi
	fi

	if echo "${answer}" | grep -qi y ; then
		if [ "${MORS_UNINSTALL_PREVIOUS_STATE:-}" = unconfigured ]; then
			ready 'Проверяем пассивное состояние Mors перед удалением...'
			setup__verify_runtime_removed && when_ok 'УСПЕШНО' || {
				when_bad 'ОШИБКА'
				error 'Удаление остановлено: unconfigured-установка содержит активный runtime или hooks.'
				return 1
			}
			setup__remove_package "${rm_type}" || return 1
			print_line
			echo 'Пассивная установка Mors удалена.'
			return 0
		fi
		if [ "${rm_type}" = full ]; then
			mess="Удаляем все архивные данные и все зависимые пакеты..."
			rm -f /opt/etc/init/K56dnsmasq  /opt/etc/init/K09dnscrypt-proxy2
		elif [ "${rm_type}" == develop ] ; then
			all_services_rm_develop_mode
		else
#			Сохраняем значимые файлы конфигурации
			save_backups || {
				error "Удаление отменено: резервная копия не создана."
				return 1
			}
			mess="Удаляем все архивные данные, зависимые пакеты оставляем."
		fi
		[ -z "${sure}" ] && print_line
		echo "${mess}"

		list__backup
		telemetry_lifecycle__deactivate "$([ "${rm_type}" = full ] && printf true || printf false)"
		telemetry_status=$?
		if [ "${telemetry_status}" -ne 0 ]; then
			case "${telemetry_status}" in
				4) error 'Удаление остановлено: путь S98mors-telemetry не принадлежит Mors. Переместите его вручную и повторите удаление.' ;;
				*) error 'Удаление остановлено: telemetry sender не завершился или его состояние повреждено.' ;;
			esac
			return 1
		fi

		if has_ssr_enable ; then
			ready 'Останавливаем службу Shadowsocks '
			/opt/etc/init.d/S22shadowsocks stop &>/dev/null && when_ok 'УСПЕШНО' || when_bad 'ОШИБКА'
			config__restore_from_opkg "${SHADOWSOCKS_CONF}"
		fi
		uninstall_dns_backend=dnsmasq
		if cmd_adguardhome_status | grep -q 'ВКЛЮЧЕН' ; then
			uninstall_dns_backend=adguard
			ready 'Останавливаем службу AdGuardHome '
			${ADGUARDHOME_DEMON} stop &>/dev/null && when_ok 'УСПЕШНО' || when_bad 'ОШИБКА'
			config__restore_from_opkg "${ADGUARDHOME_CONFIG}"
		else
			ready 'Останавливаем службу DNSMasq '
			${DNSMASQ_DEMON} stop &>/dev/null && when_ok 'УСПЕШНО' || when_bad 'ОШИБКА'
			config__restore_from_opkg "${DNSMASQ_CONFIG}"

			ready 'Останавливаем службу DNSCrypt '
			${DNSCRYPT_DEMON} stop &>/dev/null && when_ok 'УСПЕШНО' || when_bad 'ОШИБКА'
			config__restore_from_opkg "${DNSCRYPT_CONFIG}"
		fi
		[ -f "${VLESS_SUPERVISOR_INIT}" ] && vless_runtime__supervisor_service stop &>/dev/null || true
		[ -f "${XRAY_INIT}" ] && "${XRAY_INIT}" stop &>/dev/null || true

		# Подключаем библиотеку keen_api
		#source /opt/apps/mors/bin/libs/keen_api
		# Удаляем DNS сервера, установленне для Морса
		#del_dns_router_server_ip $(get_router_ip) ${MAIN_DNS_PORT}
		# Устанавливаем DNS роутера и порт по умолчанию
		#set_dns_router_server_ip "77.88.8.8" "53"

		# Удаляем правила в брандмауэре, установленные при инсталяции Морса
		# del_firewall_rules 53 tcp "deny"
		# del_firewall_rules 53 udp "deny"

		# Удаляем правила в брандмауэре, установленные при инсталяции Морса
		# local _local_net="$(get_router_ip | cut -d'.' -f1-3).0"
		# del_firewall_rules 53 tcp "permit" "${_local_net}"
		# del_firewall_rules 53 udp "permit" "${_local_net}"

		# Сохраняем конфигурацию
		#save_system_configuration_by_api

		#ready 'Очищаем используемые сетевые правила...'
		# Нормально отработает, пока все файлы на месте.
		# Ведь внутри может проверять тип текущего тоннеля и прочее.
		#ip4__flush &> /dev/null
		#if [ $? = 0 ]; then when_ok 'УСПЕШНО'; else when_bad 'ОШИБКА'; fi

		ready 'Очищаем всевозможные сетевые правила...'
		clear_previous_version_net_rules &> /dev/null
		if [ $? = 0 ]; then when_ok 'УСПЕШНО'; else when_bad 'ОШИБКА'; fi

		ready 'Восстанавливаем штатный DNS после очистки Mors...'
		if [ "${uninstall_dns_backend}" = adguard ] && [ -x /opt/etc/init.d/S99adguardhome ]; then
			restore_adguard >/dev/null 2>&1 || true
			/opt/etc/init.d/S99adguardhome restart >/dev/null 2>&1 || {
				when_bad 'ОШИБКА'
				error 'Удаление остановлено: штатный AdGuard Home не запустился.'
				return 1
			}
		elif [ -x /opt/etc/init.d/S56dnsmasq ]; then
			/opt/etc/init.d/S56dnsmasq restart >/dev/null 2>&1 || {
				when_bad 'ОШИБКА'
				error 'Удаление остановлено: штатный DNSMasq не запустился.'
				return 1
			}
			if [ -x /opt/etc/init.d/S09dnscrypt-proxy2 ]; then
				/opt/etc/init.d/S09dnscrypt-proxy2 restart >/dev/null 2>&1 || true
			fi
		else
			when_bad 'ОШИБКА'
			error 'Удаление остановлено: штатный DNS-сервис не найден.'
			return 1
		fi
		when_ok 'УСПЕШНО'

		ready 'Отключаем init- и NDM-интеграции Mors...'
		setup__deactivate_core_hooks && when_ok 'УСПЕШНО' || {
			when_bad 'ОШИБКА'
			error 'Удаление остановлено: не удалось отключить системные hooks Mors.'
			return 1
		}

		ready 'Проверяем очистку runtime перед удалением пакета...'
		setup__verify_runtime_removed && when_ok 'УСПЕШНО' || {
			when_bad 'ОШИБКА'
			error 'Удаление остановлено: в firewall или ipset остались активные объекты Mors.'
			return 1
		}

		# Не используем --autoremove: dnsmasq/ipset/iptables могут обслуживать
		# сам роутер и другие пакеты даже если когда-то были auto-installed.
		setup__remove_package "${rm_type}" || return 1

		print_line
		echo "Удаление МОРСа завершено."
	fi
}

setup__deactivate_core_hooks() {
	rm_file /opt/etc/ndm/netfilter.d/100-dns-local
	rm_file /opt/etc/ndm/netfilter.d/100-vpn-mark
	rm_file /opt/etc/ndm/netfilter.d/100-proxy-redirect
	rm_file /opt/etc/ndm/fs.d/15-mors-start.sh
	rm_file /opt/etc/ndm/ifcreated.d/mors-iface-add
	rm_file /opt/etc/ndm/ifdestroyed.d/mors-iface-del
	rm_file /opt/etc/ndm/iflayerchanged.d/100-mors-vpn
	rm_file /opt/etc/init.d/S96mors
	rm_file /opt/etc/init.d/S25mors-vless
	rm_file /opt/etc/init.d/S97xray
	rm_file /opt/etc/cron.5mins/vless-watchdog
	rm_file /opt/etc/cron.5mins/check_vpn
}

setup__verify_runtime_removed() {
	local iptables_state ipset_state
	iptables_state=$(save_iptables 2>/dev/null) || return 1
	printf '%s\n' "${iptables_state}" | grep -qE '(^|[[:space:]:])MORS(_|[[:space:]])' && return 1
	if command -v ipset >/dev/null 2>&1; then
		ipset_state=$(ipset list -n 2>/dev/null) || return 1
	elif [ -x /opt/sbin/ipset ]; then
		ipset_state=$(/opt/sbin/ipset list -n 2>/dev/null) || return 1
	else
		return 1
	fi
	printf '%s\n' "${ipset_state:-}" | grep -qE '^MORS($|_)' && return 1
	for path in \
		/opt/etc/init.d/S96mors \
		/opt/etc/init.d/S25mors-vless \
		/opt/etc/init.d/S97xray \
		/opt/etc/ndm/fs.d/15-mors-start.sh \
		/opt/etc/ndm/netfilter.d/100-dns-local \
		/opt/etc/ndm/netfilter.d/100-vpn-mark \
		/opt/etc/ndm/netfilter.d/100-proxy-redirect \
		/opt/etc/ndm/ifcreated.d/mors-iface-add \
		/opt/etc/ndm/ifdestroyed.d/mors-iface-del \
		/opt/etc/ndm/iflayerchanged.d/100-mors-vpn \
		/opt/etc/cron.5mins/vless-watchdog \
		/opt/etc/cron.5mins/check_vpn; do
		[ ! -e "${path}" ] && [ ! -L "${path}" ] || return 1
	done
	telemetry_lifecycle__passive_runtime_removed
}

setup__activate_core_hooks() {
	mkdir -p /opt/etc/init.d /opt/etc/ndm/fs.d /opt/etc/ndm/netfilter.d \
		/opt/etc/ndm/ifcreated.d /opt/etc/ndm/ifdestroyed.d \
		/opt/etc/ndm/iflayerchanged.d /opt/etc/cron.5mins || return 1
	cp -f /opt/apps/mors/etc/init.d/S96mors /opt/etc/init.d/S96mors || return 1
	ln -sf /opt/apps/mors/etc/init.d/S25mors-vless /opt/etc/init.d/S25mors-vless || return 1
	ln -sf /opt/apps/mors/etc/init.d/S97xray /opt/etc/init.d/S97xray || return 1
	cp -f /opt/apps/mors/etc/ndm/fs.d/15-mors-start.sh /opt/etc/ndm/fs.d/15-mors-start.sh || return 1
	cp -f /opt/apps/mors/etc/ndm/netfilter.d/100-dns-local /opt/etc/ndm/netfilter.d/100-dns-local || return 1
	ln -sf /opt/apps/mors/etc/ndm/ifcreated.d/mors-iface-add /opt/etc/ndm/ifcreated.d/mors-iface-add || return 1
	ln -sf /opt/apps/mors/etc/ndm/ifdestroyed.d/mors-iface-del /opt/etc/ndm/ifdestroyed.d/mors-iface-del || return 1
	ln -sf /opt/apps/mors/etc/ndm/iflayerchanged.d/100-mors-vpn /opt/etc/ndm/iflayerchanged.d/100-mors-vpn || return 1
	rm -f /opt/etc/ndm/netfilter.d/100-vpn-mark /opt/etc/ndm/netfilter.d/100-proxy-redirect || return 1
	if [[ "${MORS_SETUP_INTERFACE_ENTWARE:-}" =~ ${SSR_ENTWARE_TEMPL} ]]; then
		cp -f /opt/apps/mors/etc/ndm/netfilter.d/100-proxy-redirect /opt/etc/ndm/netfilter.d/100-proxy-redirect || return 1
		chmod 755 /opt/etc/ndm/netfilter.d/100-proxy-redirect || return 1
	else
		cp -f /opt/apps/mors/etc/ndm/netfilter.d/100-vpn-mark /opt/etc/ndm/netfilter.d/100-vpn-mark || return 1
		chmod 755 /opt/etc/ndm/netfilter.d/100-vpn-mark || return 1
	fi
	if [ "${MORS_SETUP_INTERFACE_CLI:-}" = "${PROXY_VLESS_NAME}" ]; then
		rm -f /opt/etc/cron.5mins/check_vpn || return 1
		ln -sf /opt/apps/mors/bin/main/vless-watchdog /opt/etc/cron.5mins/vless-watchdog || return 1
	else
		rm -f /opt/etc/cron.5mins/vless-watchdog || return 1
		ln -sf /opt/apps/mors/bin/main/check_vpn /opt/etc/cron.5mins/check_vpn || return 1
	fi
	chmod 755 /opt/etc/init.d/S96mors \
		/opt/etc/ndm/fs.d/15-mors-start.sh \
		/opt/etc/ndm/netfilter.d/100-dns-local || return 1
}

setup__managed_vless_live() {
	curl -fsS "${INFACE_REQUEST}" | jq -ce \
		--arg id "${PROXY_VLESS_NAME}" \
		--arg entware "${PROXY_VLESS_ENTWARE:-t2s21}" '
		.[]
		| select(.id == $id and .type == "Proxy" and ."interface-name" != null)
		| {cli: .id, entware: $entware}
	'
}

setup__record_selected_interface_mapping() {
	local parent temporary description
	[ -n "${MORS_SETUP_INTERFACE_CLI:-}" ] || return 1
	[ -n "${MORS_SETUP_INTERFACE_ENTWARE:-}" ] || return 1
	parent=$(dirname "${INFACE_NAMES_FILE}") || return 1
	temporary="${INFACE_NAMES_FILE}.setup.$$"
	description=$(printf '%s' "${MORS_SETUP_INTERFACE_DESCRIPTION:-${MORS_SETUP_INTERFACE_CLI}}" | tr '\r\n|' '   ') || return 1
	[ -n "${description}" ] || description=${MORS_SETUP_INTERFACE_CLI}
	umask 077
	mkdir -p "${parent}" || return 1
	if [ -r "${INFACE_NAMES_FILE}" ]; then
		awk -F '|' \
			-v cli="${MORS_SETUP_INTERFACE_CLI}" \
			-v entware="${MORS_SETUP_INTERFACE_ENTWARE}" \
			'$1 != cli && $2 != entware' "${INFACE_NAMES_FILE}" >"${temporary}" || {
			rm -f "${temporary}"
			return 1
		}
	else
		: >"${temporary}" || return 1
	fi
	printf '%s|%s|%s\n' \
		"${MORS_SETUP_INTERFACE_CLI}" \
		"${MORS_SETUP_INTERFACE_ENTWARE}" \
		"${description}" >>"${temporary}" || {
		rm -f "${temporary}"
		return 1
	}
	chmod 600 "${temporary}" || {
		rm -f "${temporary}"
		return 1
	}
	mv -f "${temporary}" "${INFACE_NAMES_FILE}"
}

setup__print_install_completed() {
	local output
	log_warning 'Установка пакета МОРС завершена'
	print_line
	echo 'Установка пакета МОРС завершена.'
	echo -e "Для справки по командам введите ${BLUE}mors help${NOCL}."

	output="$(hint__if_ndnproxy_disabled)"
	if [ -n "${output}" ] ; then
		echo
		echo "${output}"
		log_in_file 'Показан совет включить системный DNS.'
	fi

	output="$(hint__if_dns_ipv6)"
	if [ -n "${output}" ] ; then
		echo
		echo "${output}"
		log_in_file 'Показан совет отключить DHCPv6.'
	fi

	log_in_file line
	log_in_file "Установка завершена $(date "${DATE_FORMAT}")"
}

setup__prepare_selected_interface() {
	local live attempt
	[ "${MORS_SETUP_INTERFACE_CLI:-}" = "${PROXY_VLESS_NAME}" ] || return 0
	if live=$(setup__managed_vless_live 2>/dev/null); then
		[ "$(printf '%s\n' "${live}" | jq -r '.entware')" = "${MORS_SETUP_INTERFACE_ENTWARE}" ]
		return $?
	fi
	[ "${MORS_SETUP_INTERFACE_PROVISIONING:-}" = managed_vless ] || {
		error 'Выбранный Proxy21 исчез после построения setup plan.'
		return 1
	}
	setup_plan__managed_vless_available || {
		error 'Для VLESS установите системные компоненты Keenetic Proxy client, Netfilter и Netfilter Add-ons.'
		return 1
	}
	setup_plan__journal_provision_state creating || return 1
	create_proxy_interface || return 1
	attempt=10
	while [ "${attempt}" -gt 0 ]; do
		if live=$(setup__managed_vless_live 2>/dev/null); then
			[ "$(printf '%s\n' "${live}" | jq -r '.entware')" = "${MORS_SETUP_INTERFACE_ENTWARE}" ] || return 1
			setup_plan__journal_provision_state created
			return $?
		fi
		attempt=$((attempt - 1))
		sleep 1
	done
	error 'Keenetic не опубликовал созданный интерфейс Proxy21.'
	return 1
}

setup__rollback_provisioned_interface() {
	local journal provisioning provision_state attempt
	journal=$(lifecycle_transaction__journal_file) || return 1
	provisioning=$(jq -r '.plan.provisioning // "existing"' "${journal}" 2>/dev/null) || return 1
	provision_state=$(jq -r '.plan.provision_state // "none"' "${journal}" 2>/dev/null) || return 1
	[ "${provisioning}" = managed_vless ] || return 0
	case "${provision_state}" in creating|created) ;; *) return 0 ;; esac
	setup__managed_vless_live >/dev/null 2>&1 || return 0
	delete_proxy_interface || return 1
	attempt=10
	while [ "${attempt}" -gt 0 ]; do
		setup__managed_vless_live >/dev/null 2>&1 || return 0
		attempt=$((attempt - 1))
		sleep 1
	done
	return 1
}

setup__service_running() {
	local service output
	service=${1}
	[ -x "${service}" ] || return 1
	output=$("${service}" status 2>/dev/null || true)
	printf '%s\n' "${output}" | grep -qiE 'dead|not[[:space:]]+running|stopped' && return 1
	printf '%s\n' "${output}" | grep -qiE '(^|[[:space:]])(alive|running)([[:space:].]|$)'
}

setup__verify_failed() {
	error "Lifecycle verification: ${1}"
	return 1
}

setup__verify_committed() {
	local expected_cli expected_entware dns_backend iptables_state ipset_state ip_binary rule_state route_state path
	expected_cli=${MORS_SETUP_INTERFACE_CLI:-$(get_config_value INFACE_CLI)}
	expected_entware=${MORS_SETUP_INTERFACE_ENTWARE:-$(get_config_value INFACE_ENT)}
	if [ -z "${expected_cli}" ] || [ -z "${expected_entware}" ]; then
		setup__verify_failed 'не определён выбранный интерфейс'
		return 1
	fi
	[ "$(get_config_value INFACE_CLI)" = "${expected_cli}" ] || \
		setup__verify_failed "INFACE_CLI не равен ${expected_cli}" || return 1
	[ "$(get_config_value INFACE_ENT)" = "${expected_entware}" ] || \
		setup__verify_failed "INFACE_ENT не равен ${expected_entware}" || return 1
	for path in \
		/opt/etc/init.d/S96mors \
		/opt/etc/ndm/fs.d/15-mors-start.sh \
		/opt/etc/ndm/netfilter.d/100-dns-local \
		/opt/etc/ndm/ifcreated.d/mors-iface-add \
		/opt/etc/ndm/ifdestroyed.d/mors-iface-del \
		/opt/etc/ndm/iflayerchanged.d/100-mors-vpn; do
		[ -x "${path}" ] || setup__verify_failed "не активирован ${path}" || return 1
	done
	dns_backend=${MORS_SETUP_DNS_BACKEND:-}
	if [ -z "${dns_backend}" ]; then
		has_adguard_enable && dns_backend=adguard || dns_backend=dnscrypt
	fi
	case "${dns_backend}" in
		adguard)
			[ -r "${ADGUARDHOME_CONFIG}" ] || setup__verify_failed 'не читается конфигурация AdGuard Home' || return 1
			setup__service_running "${ADGUARDHOME_DEMON}" || setup__verify_failed 'AdGuard Home не запущен' || return 1
			;;
		dnscrypt)
			if [ ! -r "${DNSMASQ_CONFIG}" ] || [ ! -r "${DNSCRYPT_CONFIG}" ]; then
				setup__verify_failed 'не читается конфигурация dnsmasq или DNSCrypt'
				return 1
			fi
			setup__service_running "${DNSMASQ_DEMON}" || setup__verify_failed 'dnsmasq не запущен' || return 1
			setup__service_running "${DNSCRYPT_DEMON}" || setup__verify_failed 'DNSCrypt не запущен' || return 1
			;;
		*) setup__verify_failed "неизвестный DNS backend ${dns_backend}"; return 1 ;;
	esac
	if [ "${expected_cli}" = "${PROXY_VLESS_NAME}" ]; then
		setup__managed_vless_live >/dev/null 2>&1 || setup__verify_failed 'Proxy21 не опубликован Keenetic' || return 1
		setup__service_running "${XRAY_INIT}" || setup__verify_failed 'Xray не запущен' || return 1
	fi
	iptables_state=$(save_iptables 2>/dev/null) || setup__verify_failed 'не удалось прочитать iptables' || return 1
	printf '%s\n' "${iptables_state}" | grep -qE '(^|[[:space:]:])MORS(_|[[:space:]])' || \
		setup__verify_failed 'отсутствуют цепочки MORS в iptables' || return 1
	if command -v ipset >/dev/null 2>&1; then
		ipset_state=$(ipset list -n 2>/dev/null) || setup__verify_failed 'не удалось прочитать ipset' || return 1
	elif [ -x /opt/sbin/ipset ]; then
		ipset_state=$(/opt/sbin/ipset list -n 2>/dev/null) || setup__verify_failed 'не удалось прочитать ipset' || return 1
	else
		setup__verify_failed 'команда ipset недоступна'
		return 1
	fi
	printf '%s\n' "${ipset_state}" | grep -qE '^MORS($|_)' || setup__verify_failed 'отсутствуют таблицы MORS в ipset' || return 1
	if ! [[ "${expected_entware}" =~ ${SSR_ENTWARE_TEMPL} ]]; then
		if command -v ip >/dev/null 2>&1; then
			ip_binary=$(command -v ip)
		elif [ -x /opt/sbin/ip ]; then
			ip_binary=/opt/sbin/ip
		else
			setup__verify_failed 'команда ip недоступна'
			return 1
		fi
		rule_state=$("${ip_binary}" rule show 2>/dev/null) || setup__verify_failed 'не удалось прочитать policy rules' || return 1
		printf '%s\n' "${rule_state}" | grep -qE "lookup[[:space:]]+${ROUTE_TABLE_ID:-1001}([[:space:]]|$)" || \
			setup__verify_failed "отсутствует policy rule для таблицы ${ROUTE_TABLE_ID:-1001}" || return 1
		route_state=$("${ip_binary}" route show table "${ROUTE_TABLE_ID:-1001}" 2>/dev/null) || \
			setup__verify_failed "не удалось прочитать таблицу ${ROUTE_TABLE_ID:-1001}" || return 1
		[ -n "${route_state}" ] || setup__verify_failed "таблица ${ROUTE_TABLE_ID:-1001} пуста" || return 1
	fi
}

setup__rollback_transaction() {
	local previous_state phase result=0
	previous_state=$(jq -er '.previous_state' "$(lifecycle_transaction__journal_file)" 2>/dev/null) || return 1
	phase=$(jq -er '.phase' "$(lifecycle_transaction__journal_file)" 2>/dev/null) || return 1
	if [ "${phase}" = completed ]; then
		lifecycle_transaction__reconcile_completed
		return $?
	fi
	if [ "${phase}" = planning ]; then
		lifecycle_transaction__rollback_finish
		return $?
	fi
	lifecycle_transaction__phase rolling_back || return 1
	MORS_LIFECYCLE_APPLY=true
	export MORS_LIFECYCLE_APPLY
	clear_previous_version_net_rules >/dev/null 2>&1 || true
	setup__deactivate_core_hooks || result=1
	[ "${result}" -ne 0 ] || setup__rollback_provisioned_interface || result=1
	[ "${result}" -ne 0 ] || lifecycle_snapshot__restore || result=1
	if [ "${result}" -eq 0 ] && [ "${previous_state}" = ready ]; then
		(
			export MORS_LIFECYCLE_APPLY
			cmd_mors_init no
		) >/dev/null 2>&1 || result=1
		[ "${result}" -ne 0 ] || setup__verify_committed || result=1
	elif [ "${result}" -eq 0 ]; then
		setup__verify_runtime_removed || result=1
	fi
	[ "${result}" -ne 0 ] || lifecycle_transaction__rollback_finish || result=1
	unset MORS_LIFECYCLE_APPLY
	return "${result}"
}

setup__remove_package() {
	local rm_type
	rm_type=${1:-}
	lifecycle_transaction__phase package_remove_ready || return 1
	if [ "${rm_type}" = full ]; then
		: >"${MORS_LIFECYCLE_ROOT}/purge-requested" || return 1
		chmod 600 "${MORS_LIFECYCLE_ROOT}/purge-requested" || return 1
	fi
	ready 'Удаляем пакет Морс...'
	if opkg remove mors &> /dev/null; then
		when_ok 'УСПЕШНО'
	else
		when_bad 'ОШИБКА'
		error 'opkg не подтвердил удаление пакета. Lifecycle journal сохранён.'
		return 1
	fi
}

setup__has_yes() {
	local argument
	for argument in "$@"; do
		[ "${argument}" = --yes ] && return 0
	done
	return 1
}

setup_cli__parse_options() {
	MORS_SETUP_CLI_INTERFACE=''
	MORS_SETUP_CLI_DNS=''
	MORS_SETUP_CLI_JSON=false
	MORS_SETUP_CLI_YES=false
	while [ "$#" -gt 0 ]; do
		case "$1" in
			--interface)
				shift
				[ "$#" -gt 0 ] || return 64
				MORS_SETUP_CLI_INTERFACE=$1
				;;
			--dns)
				shift
				[ "$#" -gt 0 ] || return 64
				MORS_SETUP_CLI_DNS=$1
				;;
			--json) MORS_SETUP_CLI_JSON=true ;;
			--yes) MORS_SETUP_CLI_YES=true ;;
			*) return 64 ;;
		esac
		shift
	done
}

cmd_setup_cli() {
	local action answer phase operation format plan_status
	action=${1:-interactive}
	case "${action}" in
		plan)
			shift
			setup_cli__parse_options "$@" || return 64
			[ "${MORS_SETUP_CLI_YES}" = false ] || return 64
			format=human
			[ "${MORS_SETUP_CLI_JSON}" = true ] && format=json
			if [ -z "${MORS_SETUP_CLI_INTERFACE}" ] && [ -z "${MORS_SETUP_CLI_DNS}" ]; then
				setup_plan__print_inventory "${format}"
			else
				[ -n "${MORS_SETUP_CLI_INTERFACE}" ] && [ -n "${MORS_SETUP_CLI_DNS}" ] || return 64
				setup_plan__select "${MORS_SETUP_CLI_INTERFACE}" "${MORS_SETUP_CLI_DNS}" || return $?
				setup_plan__print "${format}"
			fi
			;;
		apply)
			shift
			setup_cli__parse_options "$@" || return 64
			[ "${MORS_SETUP_CLI_JSON}" = false ] || return 64
			[ "${MORS_SETUP_CLI_YES}" = true ] || {
				error 'Для неинтерактивной настройки требуется --yes.'
				return 64
			}
			[ -n "${MORS_SETUP_CLI_INTERFACE}" ] && [ -n "${MORS_SETUP_CLI_DNS}" ] || {
				error 'Для apply обязательны --interface и --dns.'
				return 64
			}
			setup_plan__select "${MORS_SETUP_CLI_INTERFACE}" "${MORS_SETUP_CLI_DNS}" || return $?
			setup_plan__print human
			cmd_install
			;;
		resume)
			setup__has_yes "$@" || {
				error 'Для продолжения настройки требуется --yes.'
				return 64
			}
			phase=$(jq -er '.phase' "$(lifecycle_transaction__journal_file)" 2>/dev/null) || return 3
			operation=$(jq -er '.operation' "$(lifecycle_transaction__journal_file)" 2>/dev/null) || return 3
			[ "${operation}" = setup ] && [ "${phase}" = awaiting_reboot ] || {
				error 'Нет настройки, ожидающей продолжения после перезагрузки.'
				return 3
			}
			MORS_SETUP_RESUME=true
			export MORS_SETUP_RESUME
			cmd_install
			;;
		recover)
			setup__has_yes "$@" || {
				error 'Для восстановления требуется --yes.'
				return 64
			}
			cmd_setup_recover
			;;
		interactive)
			[ -t 0 ] && [ -t 1 ] || {
				error 'В неинтерактивном режиме используйте mors setup apply --interface ID --dns BACKEND --yes.'
				return 64
			}
			setup_plan__interactive
			plan_status=$?
			[ "${plan_status}" -eq 0 ] || {
				error 'Не удалось выбрать безопасный setup plan.'
				return "${plan_status}"
			}
			setup_plan__print human
			printf 'Продолжить настройку? [y/N]: '
			IFS= read -r answer || return 64
			case "${answer}" in
				y|Y|yes|YES|Yes|да|Да|ДА) cmd_install ;;
				*) echo 'Настройка отменена. Изменения не выполнены.' ;;
			esac
			;;
		*)
			error "Неизвестное действие setup: ${action}."
			return 64
			;;
	esac
}

cmd_install() {
	lifecycle__run_locked setup__cmd_install_with_runtime "$@"
}

cmd_setup_recover() {
	lifecycle__run_locked setup__recover_with_runtime
}

setup__recover_with_runtime() {
	local result operation phase
	operation=$(jq -er '.operation' "$(lifecycle_transaction__journal_file)" 2>/dev/null) || return 3
	phase=$(jq -er '.phase' "$(lifecycle_transaction__journal_file)" 2>/dev/null) || return 4
	case "${operation}" in
		setup|uninstall) ;;
		*) error "Для транзакции ${operation} требуется recovery обновления."; return 3 ;;
	esac
	runtime_mutation_lock__acquire_or_explain 'mors setup recover' || return $?
	setup__rollback_transaction
	result=$?
	runtime_mutation_lock__release || [ "${result}" -ne 0 ] || result=1
	if [ "${result}" -eq 0 ]; then
		if [ "${phase}" = completed ]; then
			echo 'Завершённое lifecycle-состояние согласовано и проверено.'
		else
			echo 'Исходное состояние восстановлено и проверено.'
		fi
	else
		lifecycle_transaction__mark_recovery_required setup_recovery_failed 2>/dev/null || true
		error 'Не удалось подтвердить восстановление. Journal и snapshot сохранены.'
	fi
	return "${result}"
}

cmd_uninstall() {
	lifecycle__run_locked setup__cmd_uninstall_with_runtime "$@"
}

cmd_uninstall_cli() {
	local purge=false confirmed=false argument answer
	# Deprecated compatibility for the previous package/MOLOT contract.
	[ "${1:-}" = full ] && purge=true
	[ "${2:-}" = yes ] && confirmed=true
	for argument in "$@"; do
		case "${argument}" in
			--purge) purge=true ;;
			--yes) confirmed=true ;;
			full|yes|'') ;;
			recover)
				setup__has_yes "$@" || return 64
				cmd_setup_recover
				return $?
				;;
			*) error "Неизвестный аргумент uninstall: ${argument}."; return 64 ;;
		esac
	done
	if [ "${confirmed}" != true ]; then
		[ -t 0 ] && [ -t 1 ] || {
			error 'В неинтерактивном режиме для удаления требуется --yes.'
			return 64
		}
		printf 'Удалить Mors%s? [y/N]: ' "$([ "${purge}" = true ] && printf ' вместе с пользовательскими данными')"
		IFS= read -r answer || return 64
		case "${answer}" in
			y|Y|yes|YES|Yes|да|Да|ДА) confirmed=true ;;
			*) echo 'Удаление отменено. Изменения не выполнены.'; return 0 ;;
		esac
	fi
	[ "${purge}" = true ] && cmd_uninstall full yes || cmd_uninstall '' yes
}

setup__cmd_install_with_runtime() {
	local result state operation phase new_transaction
	state=$(lifecycle_state__read) || return 4
	new_transaction=false
	if lifecycle_state__has_active_marker; then
		[ "${MORS_SETUP_RESUME:-false}" = true ] || return 3
		operation=$(jq -er '.operation' "$(lifecycle_transaction__journal_file)" 2>/dev/null) || return 4
		phase=$(jq -er '.phase' "$(lifecycle_transaction__journal_file)" 2>/dev/null) || return 4
		[ "${operation}" = setup ] && [ "${phase}" = awaiting_reboot ] || return 3
		setup_plan__journal_load || return 4
	else
		[ "${state}" = unconfigured ] || {
			error 'Повторный setup для работающей установки не выполняется автоматически.'
			return 3
		}
		setup_plan__validate_selected || return $?
		new_transaction=true
	fi
	runtime_mutation_lock__acquire_or_explain 'mors setup' || return $?
	if [ "${new_transaction}" = true ]; then
		lifecycle_transaction__begin setup "${state}" ready >/dev/null || {
			result=$?
			runtime_mutation_lock__release >/dev/null 2>&1 || true
			return "${result}"
		}
		setup_plan__journal_store || {
			result=$?
			lifecycle_transaction__rollback_finish >/dev/null 2>&1 || true
			runtime_mutation_lock__release >/dev/null 2>&1 || true
			return "${result}"
		}
		lifecycle_snapshot__capture || {
			result=$?
			lifecycle_transaction__rollback_finish >/dev/null 2>&1 || true
			runtime_mutation_lock__release >/dev/null 2>&1 || true
			return "${result}"
		}
		lifecycle_transaction__phase prepared || {
			runtime_mutation_lock__release >/dev/null 2>&1 || true
			return 1
		}
	fi
	lifecycle_transaction__phase applying || {
		runtime_mutation_lock__release >/dev/null 2>&1 || true
		return 1
	}
	(
		MORS_LIFECYCLE_APPLY=true
		export MORS_LIFECYCLE_APPLY
		setup__cmd_install_unlocked "$@"
	)
	result=$?
	if [ "${result}" -eq 75 ]; then
		runtime_mutation_lock__release >/dev/null 2>&1 || true
		warning 'Для продолжения настройки после перезагрузки выполните mors setup resume --yes.'
		return 0
	fi
	if [ "${result}" -eq 0 ]; then
		lifecycle_transaction__phase verifying || result=1
		setup__verify_committed || result=1
	fi
	if [ "${result}" -eq 0 ]; then
		lifecycle_transaction__finish || result=1
		[ "${result}" -ne 0 ] || setup__print_install_completed || true
	else
		if setup__rollback_transaction; then
			error 'Настройка не завершена. Исходное состояние восстановлено.'
			result=2
		else
			lifecycle_transaction__mark_recovery_required setup_failed 2>/dev/null || true
			error 'Настройка не завершена. Новые изменения заблокированы до восстановления.'
		fi
	fi
	runtime_mutation_lock__release || [ "${result}" -ne 0 ] || result=1
	return "${result}"
}

setup__cmd_uninstall_with_runtime() {
	local result state
	state=$(lifecycle_state__read) || return 4
	if lifecycle_state__has_active_marker; then
		error 'Другая lifecycle-транзакция не завершена.'
		return 3
	fi
	runtime_mutation_lock__acquire_or_explain 'mors uninstall' || return $?
	lifecycle_transaction__begin uninstall "${state}" unconfigured >/dev/null || {
		result=$?
		runtime_mutation_lock__release >/dev/null 2>&1 || true
		return "${result}"
	}
	lifecycle_snapshot__capture || {
		result=$?
		lifecycle_transaction__rollback_finish >/dev/null 2>&1 || true
		runtime_mutation_lock__release >/dev/null 2>&1 || true
		return "${result}"
	}
	lifecycle_transaction__phase prepared || {
		runtime_mutation_lock__release >/dev/null 2>&1 || true
		return 1
	}
	lifecycle_transaction__phase cleanup || {
		runtime_mutation_lock__release >/dev/null 2>&1 || true
		return 1
	}
	MORS_UNINSTALL_PREVIOUS_STATE=${state}
	export MORS_UNINSTALL_PREVIOUS_STATE
	(
		MORS_LIFECYCLE_APPLY=true
		export MORS_LIFECYCLE_APPLY
		setup__cmd_uninstall_unlocked "$@"
	)
	result=$?
	unset MORS_UNINSTALL_PREVIOUS_STATE
	if [ "${result}" -ne 0 ]; then
		if setup__rollback_transaction; then
			error 'Удаление не завершено. Рабочее состояние восстановлено.'
			result=2
		else
			lifecycle_transaction__mark_recovery_required uninstall_failed 2>/dev/null || true
		fi
	fi
	runtime_mutation_lock__release || [ "${result}" -ne 0 ] || result=1
	return "${result}"
}

