#!/bin/sh
. /opt/apps/mors/bin/libs/main
. /opt/apps/mors/bin/libs/vpn
. /opt/apps/mors/bin/libs/vless
. /opt/apps/mors/bin/libs/lifecycle

# В случае проблем с инсталляцией пакета ставим в значение true
ANSWER_AGH=n

setup_require_supported_os() {
	local firmware_version
	firmware_version=$(get_firmware_version)

	if [ -z "${firmware_version}" ]; then
		error 'Не удалось определить версию KeeneticOS. Установка остановлена.'
		return 1
	fi

	if ! is_supported_keenetic_os "${firmware_version}"; then
		error "KeeneticOS ${firmware_version} не поддерживается. Требуется KeeneticOS 5 или новее."
		return 1
	fi
}

log_in_file(){
	if [ "${1}" = line ]; then
		print_line >> "${INSTALL_LOG}"
	else
		echo "${1}" >> "${INSTALL_LOG}"
	fi
}


