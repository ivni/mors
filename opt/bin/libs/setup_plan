#!/bin/sh

MORS_SETUP_PLAN_RCI_URL=${MORS_SETUP_PLAN_RCI_URL:-http://127.0.0.1:79/rci/show/interface}

setup_plan__managed_vless_available() {
	case "${MORS_SETUP_PROXY_AVAILABLE:-}" in
		true) return 0 ;;
		false) return 1 ;;
	esac
	[ -r /etc/components.xml ] || return 1
	for component in proxy opkg-kmod-netfilter opkg-kmod-netfilter-addons; do
		grep -q "<name>${component}</name>" /etc/components.xml || return 1
	done
}

setup_plan__inventory_json() {
	local raw managed_vless_available=false managed_vless_entware
	if [ -n "${MORS_SETUP_PLAN_INTERFACE_JSON:-}" ]; then
		raw=${MORS_SETUP_PLAN_INTERFACE_JSON}
	else
		raw=$(curl -fsS "${MORS_SETUP_PLAN_RCI_URL}") || return 1
	fi
	setup_plan__managed_vless_available && managed_vless_available=true
	managed_vless_entware=${PROXY_VLESS_ENTWARE:-t2s21}
	printf '%s\n' "${raw}" | jq -ce \
		--arg managed_proxy "${PROXY_VLESS_NAME:-Proxy21}" \
		--arg managed_entware "${managed_vless_entware}" \
		--arg managed_description "${PROXY_VLESS_DESC:-Mors-proxy-vless}" \
		--arg legacy_description "${LEGACY_PROXY_VLESS_DESC:-Kvas-proxy-vless}" \
		--argjson raw_interfaces "${raw}" \
		--argjson managed_vless_available "${managed_vless_available}" '
		[.[]
		| select(.defaultgw != true)
		| select(
			.type == "OpenVPN" or .type == "Wireguard" or .type == "IKE" or
			.type == "SSTP" or .type == "PPPOE" or .type == "L2TP" or
			.type == "PPTP" or .type == "OpenConnect" or
			(.type == "Proxy" and .id == $managed_proxy and
				(.description == $managed_description or .description == $legacy_description))
		)
		| select(.id != null and ."interface-name" != null)
		| {
			cli: .id,
			entware: (if .type == "Proxy" and .id == $managed_proxy then $managed_entware else ."interface-name" end),
			description: (if .type == "Proxy" and .id == $managed_proxy then "Mors VLESS" else (.description // .id) end),
			original_description: (if .type == "Proxy" and .id == $managed_proxy then (.description // "") else "" end),
			state: (.state // "unknown"),
			provisioning: (if .type == "Proxy" and .id == $managed_proxy and .description == $legacy_description then "legacy_vless" else "existing" end)
		}]
		| unique_by(.cli)
		| if $managed_vless_available and
			([ $raw_interfaces[] | select(.id == $managed_proxy) ] | length == 0) then
			. + [{
				cli: $managed_proxy,
				entware: $managed_entware,
				description: "Mors VLESS",
				original_description: "",
				state: "not_configured",
				provisioning: "managed_vless"
			}]
		else . end
		| sort_by(.cli)
	'
}

setup_plan__adguard_available() {
	[ -x "${MORS_SETUP_ADGUARD_BIN:-/opt/bin/AdGuardHome}" ] &&
		[ -x "${MORS_SETUP_ADGUARD_INIT:-/opt/etc/init.d/S99adguardhome}" ] &&
		[ -r "${MORS_SETUP_ADGUARD_CONFIG:-/opt/etc/AdGuardHome/AdGuardHome.yaml}" ]
}

setup_plan__select() {
	local selector dns inventory selected count
	selector=${1:-}
	dns=${2:-}
	[ -n "${selector}" ] || return 64
	case "${dns}" in
		dnscrypt) ;;
		adguard) setup_plan__adguard_available || return 3 ;;
		*) return 64 ;;
	esac
	inventory=$(setup_plan__inventory_json) || return 2
	selected=$(printf '%s\n' "${inventory}" | jq -ce --arg selector "${selector}" \
		'[.[] | select(.cli == $selector or .entware == $selector)]') || return 2
	count=$(printf '%s\n' "${selected}" | jq -r 'length') || return 2
	[ "${count}" -eq 1 ] || return 3
	MORS_SETUP_INTERFACE_CLI=$(printf '%s\n' "${selected}" | jq -r '.[0].cli')
	MORS_SETUP_INTERFACE_ENTWARE=$(printf '%s\n' "${selected}" | jq -r '.[0].entware')
	MORS_SETUP_INTERFACE_DESCRIPTION=$(printf '%s\n' "${selected}" | jq -r '.[0].description')
	MORS_SETUP_INTERFACE_ORIGINAL_DESCRIPTION=$(printf '%s\n' "${selected}" | jq -r '.[0].original_description // ""')
	MORS_SETUP_INTERFACE_STATE=$(printf '%s\n' "${selected}" | jq -r '.[0].state')
	MORS_SETUP_INTERFACE_PROVISIONING=$(printf '%s\n' "${selected}" | jq -r '.[0].provisioning')
	MORS_SETUP_DNS_BACKEND=${dns}
	export MORS_SETUP_INTERFACE_CLI MORS_SETUP_INTERFACE_ENTWARE
	export MORS_SETUP_INTERFACE_DESCRIPTION MORS_SETUP_INTERFACE_STATE
	export MORS_SETUP_INTERFACE_ORIGINAL_DESCRIPTION
	export MORS_SETUP_INTERFACE_PROVISIONING MORS_SETUP_DNS_BACKEND
}

setup_plan__validate_selected() {
	local inventory count
	[ -n "${MORS_SETUP_INTERFACE_CLI:-}" ] || return 64
	[ -n "${MORS_SETUP_INTERFACE_ENTWARE:-}" ] || return 64
	case "${MORS_SETUP_DNS_BACKEND:-}" in
		dnscrypt) ;;
		adguard) setup_plan__adguard_available || return 3 ;;
		*) return 64 ;;
	esac
	inventory=$(setup_plan__inventory_json) || return 2
	count=$(printf '%s\n' "${inventory}" | jq -r \
		--arg cli "${MORS_SETUP_INTERFACE_CLI}" \
		--arg entware "${MORS_SETUP_INTERFACE_ENTWARE}" \
		'[.[] | select(.cli == $cli and .entware == $entware)] | length') || return 2
	[ "${count}" -eq 1 ]
}

setup_plan__print() {
	local format=${1:-human}
	if [ "${format}" = json ]; then
		jq -n \
			--arg cli "${MORS_SETUP_INTERFACE_CLI}" \
			--arg entware "${MORS_SETUP_INTERFACE_ENTWARE}" \
			--arg description "${MORS_SETUP_INTERFACE_DESCRIPTION}" \
			--arg state "${MORS_SETUP_INTERFACE_STATE}" \
			--arg provisioning "${MORS_SETUP_INTERFACE_PROVISIONING}" \
			--arg dns "${MORS_SETUP_DNS_BACKEND}" '
			{
				schema_version: 1,
				command: "setup plan",
				selected: {
					interface: {cli: $cli, entware: $entware, description: $description, state: $state, provisioning: $provisioning},
					dns_backend: $dns
				},
			changes: (["dns", "firewall", "routing", "services", "ndm_hooks"] +
					(if $provisioning == "managed_vless" then ["keenetic_proxy_interface"]
					 elif $provisioning == "legacy_vless" then ["keenetic_proxy_interface_migration"] else [] end)),
				preserved: ["mors_config", "mors_list", "tunnel_credentials"],
				may_require_reboot: false,
				recovery_command: "mors setup recover --yes"
			}'
		return
	fi
	cat <<EOF
Mors: ПЛАН НАСТРОЙКИ

VPN: ${MORS_SETUP_INTERFACE_DESCRIPTION} (${MORS_SETUP_INTERFACE_CLI} / ${MORS_SETUP_INTERFACE_ENTWARE})
Состояние VPN: ${MORS_SETUP_INTERFACE_STATE}
DNS: ${MORS_SETUP_DNS_BACKEND}
Перезагрузка: не требуется

Будут изменены DNS, Mors firewall/routes/ipset, сервисы и NDM-hooks.
$(if [ "${MORS_SETUP_INTERFACE_PROVISIONING}" = legacy_vless ]; then printf '%s\n' 'Legacy Kvas Proxy21 будет принят Mors без удаления интерфейса.'; fi)
Будут сохранены конфигурация Mors, пользовательский список и настройки тоннеля.
До финального подтверждения постоянные изменения не выполняются.
EOF
}

setup_plan__print_inventory() {
	local format=${1:-human} inventory adguard=false
	inventory=$(setup_plan__inventory_json) || return 2
	setup_plan__adguard_available && adguard=true
	if [ "${format}" = json ]; then
		jq -n --argjson interfaces "${inventory}" --argjson adguard "${adguard}" \
			--argjson managed_vless "$(setup_plan__managed_vless_available && printf true || printf false)" '
			{
				schema_version: 1,
				command: "setup plan",
				selected: null,
				interfaces: $interfaces,
				dns_backends: (["dnscrypt"] + (if $adguard then ["adguard"] else [] end)),
				managed_vless_available: $managed_vless,
				next_command: "mors setup plan --interface ID --dns dnscrypt"
			}'
		return
	fi
	echo 'Mors: ДОСТУПНЫЕ ВАРИАНТЫ НАСТРОЙКИ'
	printf '%s\n' "${inventory}" | jq -r '.[] | "- \(.description): \(.cli) / \(.entware), \(.state)"'
	setup_plan__managed_vless_available || \
		echo '- VLESS: сначала установите системные компоненты Keenetic Proxy client, Netfilter и Netfilter Add-ons'
	echo '- DNS: dnscrypt'
	[ "${adguard}" = true ] && echo '- DNS: существующий AdGuard Home'
	echo
	echo 'Для полного плана укажите --interface ID --dns BACKEND.'
}

setup_plan__interactive() {
	local inventory count number selector dns_choice answer
	inventory=$(setup_plan__inventory_json) || return 2
	count=$(printf '%s\n' "${inventory}" | jq -r 'length') || return 2
	[ "${count}" -gt 0 ] || return 3
	echo 'Доступные VPN-интерфейсы:'
	printf '%s\n' "${inventory}" | jq -r 'to_entries[] | "\(.key + 1). \(.value.description) [\(.value.cli)] — \(.value.state)"'
	printf 'Выберите интерфейс [1-%s, Q-выход]: ' "${count}"
	IFS= read -r number || return 64
	case "${number}" in q|Q) return 64 ;; esac
	printf '%s\n' "${number}" | grep -Eq '^[0-9]+$' || return 64
	[ "${number}" -ge 1 ] && [ "${number}" -le "${count}" ] || return 64
	selector=$(printf '%s\n' "${inventory}" | jq -r --argjson index "$((number - 1))" '.[$index].cli')

	dns_choice=dnscrypt
	if setup_plan__adguard_available; then
		printf 'DNS backend: [1] dnscrypt (по умолчанию), [2] существующий AdGuard Home: '
		IFS= read -r answer || return 64
		[ "${answer}" = 2 ] && dns_choice=adguard
	fi
	setup_plan__select "${selector}" "${dns_choice}"
}

setup_plan__journal_store() {
	local journal now
	journal=$(lifecycle_transaction__journal_file) || return 1
	now=$(lifecycle_state__now) || return 1
	jq \
		--arg cli "${MORS_SETUP_INTERFACE_CLI}" \
		--arg entware "${MORS_SETUP_INTERFACE_ENTWARE}" \
		--arg description "${MORS_SETUP_INTERFACE_DESCRIPTION}" \
		--arg original_description "${MORS_SETUP_INTERFACE_ORIGINAL_DESCRIPTION:-}" \
		--arg state "${MORS_SETUP_INTERFACE_STATE}" \
		--arg dns "${MORS_SETUP_DNS_BACKEND}" \
		--arg provisioning "${MORS_SETUP_INTERFACE_PROVISIONING}" \
		--arg now "${now}" '
		.plan = {
			interface_cli: $cli,
			interface_entware: $entware,
			interface_description: $description,
			interface_original_description: $original_description,
			interface_state: $state,
			dns_backend: $dns,
			provisioning: $provisioning,
			provision_state: "none"
		}
		| .updated_at = $now
	' "${journal}" | lifecycle_state__atomic_write "${journal}"
}

setup_plan__journal_provision_state() {
	local state=${1:-} journal now
	case "${state}" in creating|created|adopting|adopted) ;; *) return 64 ;; esac
	journal=$(lifecycle_transaction__journal_file) || return 1
	now=$(lifecycle_state__now) || return 1
	jq --arg state "${state}" --arg now "${now}" '
		.plan.provision_state = $state | .updated_at = $now
	' "${journal}" | lifecycle_state__atomic_write "${journal}"
}

setup_plan__journal_load() {
	local journal
	journal=$(lifecycle_transaction__journal_file) || return 1
	MORS_SETUP_INTERFACE_CLI=$(jq -er '.plan.interface_cli' "${journal}") || return 1
	MORS_SETUP_INTERFACE_ENTWARE=$(jq -er '.plan.interface_entware' "${journal}") || return 1
	MORS_SETUP_DNS_BACKEND=$(jq -er '.plan.dns_backend' "${journal}") || return 1
	MORS_SETUP_INTERFACE_PROVISIONING=$(jq -er '.plan.provisioning // "existing"' "${journal}") || return 1
	MORS_SETUP_INTERFACE_DESCRIPTION=$(jq -er '.plan.interface_description // .plan.interface_cli' "${journal}") || return 1
	MORS_SETUP_INTERFACE_ORIGINAL_DESCRIPTION=$(jq -er '.plan.interface_original_description // ""' "${journal}") || return 1
	MORS_SETUP_INTERFACE_STATE=$(jq -er '.plan.interface_state // "unknown"' "${journal}") || return 1
	export MORS_SETUP_INTERFACE_CLI MORS_SETUP_INTERFACE_ENTWARE
	export MORS_SETUP_INTERFACE_DESCRIPTION MORS_SETUP_INTERFACE_STATE
	export MORS_SETUP_INTERFACE_ORIGINAL_DESCRIPTION
	export MORS_SETUP_INTERFACE_PROVISIONING MORS_SETUP_DNS_BACKEND
	setup_plan__validate_selected
}
