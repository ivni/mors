# ------------------------------------------------------------------------------------------
#
# Обновляем таблицу iptable и правила в ней
#
# ------------------------------------------------------------------------------------------
update_iptables(){
	ready "${prefix}Очищаем все ранее созданные iptables правила."
	# возможно чистить цепочки и роутинг — лишнее
	if ip4__flush 'chain table' &>/dev/null; then
		when_ok "УСПЕШНО"
	else
		when_bad "ОШИБКА"
		return 1
	fi

	ready "${prefix}Создаем перехват DNS для домашней сети."
	if ip4__dns__add_routing_for_home &>/dev/null; then
		when_ok "УСПЕШНО"
	else
		when_bad "ОШИБКА"
		return 1
	fi

	ready "${prefix}Создаем iptables правила."
	if ip4_firewall_set_all_rules &>/dev/null; then
		when_ok "УСПЕШНО"
	else
		when_bad "ОШИБКА"
		return 1
	fi
}

adguardhome_rebuild_dataplane() {
	ip4__flush 'chain' || return 1
	ip4__dns__add_routing_for_home || return 1
	ip4_firewall_set_all_rules
}

