# ------------------------------------------------------------------------------------------
#
#	Меняем текущий порт dnscrypt_proxy2 на новый
#
#	$1 - новый номер порта
#	$2 - команда перегрузки сервиса dnsmasq
#		restart (по умолчанию) - перегружаем dnsmasq
#		norestart - не перегружаем сервис
#
# ------------------------------------------------------------------------------------------
dns_crypt_port_change() {
	local result=0
	port_new=${1}; cmd=${2:-restart}
	case "${cmd}" in restart|norestart) ;; *) return 64 ;; esac
	ready "Замена локального порта на ${port_new} в dnscrypt_proxy2 завершена"

	set_config_value DNS_CRYPT_PORT "${port_new}" || result=1
	[ "${result}" -ne 0 ] || sed -i "s/\(^listen_addresses.=.\).*$/\1['127.0.0.1:${port_new}']/g" "${DNSCRYPT_CONFIG}" &> /dev/null || result=1
	[ "${result}" -ne 0 ] || sed -i "s/\(@.*\)\(:[0-9]\{2,6\}\)/\1:${port_new} /g" '/opt/apps/mors/bin/main/ipset_domain' &> /dev/null || result=1

	[ -f /opt/apps/mors/bin/main/dnsmasq ] && {
		# server_crypt_1="echo \"server=\/\${host}\/${LOCALHOST_IP}#${port_new}\" >> \/opt\/etc\/dnsmasq.d\/mors.dnsmasq"
		sed -i '/echo \"server=/d' '/opt/apps/mors/bin/main/dnsmasq' &> /dev/null
		sed -i '/^$/N;/^\n$/D' /opt/apps/mors/bin/main/dnsmasq
		# sed -i "s/\(echo \"ipset=\/\$.*\)/\1\n\t${server_crypt_1}/" '/opt/apps/mors/bin/main/dnsmasq' &> /dev/null
	}


	[ "${result}" -ne 0 ] || cmd_dnsmasq_dns_change "${LOCALHOST_IP}#${port_new}" norestart &> /dev/null || result=1
	if [ "${result}" -eq 0 ] && [ "${cmd}" = restart ]; then
		if ! [ -f /opt/etc/init.d/S09dnscrypt-proxy2 ]; then
			if [ -f "${MORS_BACKUP_PATH}/S09dnscrypt-proxy2" ]; then
				cp "${MORS_BACKUP_PATH}/S09dnscrypt-proxy2" /opt/etc/init.d/S09dnscrypt-proxy2 || result=1
			else
				error "Нарушена работа пакета, файл /opt/etc/init.d/S09dnscrypt-proxy2 отсутствует"
				result=1
			fi
		fi
		[ "${result}" -ne 0 ] || /opt/etc/init.d/S09dnscrypt-proxy2 restart &> /dev/null || result=1
		[ "${result}" -ne 0 ] || /opt/etc/init.d/S56dnsmasq restart &> /dev/null || result=1
	fi

	[ "${result}" -eq 0 ] && when_alert "УСПЕШНО" || when_bad "С ОШИБКОЙ"
	return "${result}"
}


