reset_all_connection(){
	local result=0
	ready "${prefix}Перезапускаем VPN и ISP соединения..."
	if is_shadowsocks_enabled ; then
			log_warning 'Перезапуск клиента ShadowSocks (рестарт тоннеля)'

			vpn__service_action /opt/etc/init.d/S22shadowsocks stop &>/dev/null || result=1
			# reset_ISP_connection
			[ "${result}" -ne 0 ] || vpn__service_action /opt/etc/init.d/S22shadowsocks start &>/dev/null || result=1
	else
			inface=$(current_cli_vpn_interface)
			log_warning "Перезапуск сетевого интерфейса ${inface}"

			if is_vless_over_proxy_enabled ; then
				log_warning 'Перезапуск клиента VLESS (рестарт тоннеля)'

				vpn__service_action "${XRAY_INIT}" restart || result=1
			fi

			cli_request="localhost:79/rci/interface/${inface}"
#			curl -s -d '{"down":"true"}' "${cli_request}"  &>/dev/null
#			reset_ISP_connection
			[ "${result}" -ne 0 ] || curl -fsS -d '{"up":"true"}' "${cli_request}" &>/dev/null || result=1
	fi
	[ "${result}" -eq 0 ] && when_ok "УСПЕШНО" || when_bad "ОШИБКА"
	return "${result}"

}

# ------------------------------------------------------------------------------------------
#
# 	Производим инициализацию пакета МОРС
# 	$1 	- режим запуска функции имеет следующие значения:
#		update 		- режим обновления при выполнении mors update
#		refresh 	- режим обновления списка доменов при командах add/del/import
#	    initd		- обновить время при установке пакета
# ------------------------------------------------------------------------------------------
cmd_mors_init(){
	# Убираем ошибки сервисов, связанные с отсутствием /opt/etc/hosts, только в
	# явно изменяющем init workflow.
	mors_hosts__ensure_readable || return 1

	stage="${1:-no}"
	prefix=''
	mess="${prefix}Производим сброс пакета МОРС в исходное состояние."
	warning "${mess}"
	print_line

#	Производим перезапуск подключения к интернету
#	если не режим update и если текущее подключение не ssr
	if [ "${stage}" = refresh ] || ! has_ssr_enable ; then
		reset_all_connection || return 1
	fi

	update_iptables || return 1
	update_ipset "${stage}" || return 1
	update_adblock || return 1

	case "${stage}" in
		initd) update_time ;;
		setup_commit) return 0 ;;
		*) all_services_restart ;;
	esac

	#log_alert "${prefix}Сброс пакета МОРС в исходное состояние ЗАВЕРШЕН!"

}


vpn__service_action() {
	local service action log
	service=${1}
	action=${2}
	log=${MORS_SETUP_DNS_LOG:-}
	service_action__run "${service}" "${action}" "${log}" \
		"${MORS_SETUP_DNS_SERVICE_ACTION_TIMEOUT:-15}" \
		"${MORS_SETUP_DNS_SERVICE_KILL_AFTER:-2}" \
		"${MORS_SETUP_DNS_TIMEOUT_CMD:-/opt/bin/timeout}"
}

vpn__service_state() {
	local service log action_timeout
	service=${1}
	action_timeout=${2:-${MORS_SETUP_DNS_SERVICE_ACTION_TIMEOUT:-15}}
	log=${MORS_SETUP_DNS_LOG:-}
	service_action__state "${service}" status "${log}" \
		"${action_timeout}" \
		"${MORS_SETUP_DNS_SERVICE_KILL_AFTER:-2}" \
		"${MORS_SETUP_DNS_TIMEOUT_CMD:-/opt/bin/timeout}"
}

vpn__lifecycle_failure() {
	local reason status
	reason=${1}
	status=${2}
	[ "${MORS_LIFECYCLE_APPLY:-false}" = true ] || return 0
	command -v lifecycle_transaction__failure >/dev/null 2>&1 || return 0
	lifecycle_transaction__failure "${reason}" "${status}" >/dev/null 2>&1 || true
}

vpn__interface_state() {
	local interface_id
	interface_id=${1}
	curl -fsS "${INFACE_REQUEST}" | jq -er --arg id "${interface_id}" '
		[.[] | select(.id == $id)]
		| if length == 1 then .[0].state // empty else empty end
	'
}

vpn__wait_interface_up() {
	local interface_id attempts delay state=''
	interface_id=${1}
	attempts=${MORS_VPN_INTERFACE_UP_ATTEMPTS:-10}
	delay=${MORS_VPN_INTERFACE_UP_INTERVAL:-1}
	case "${attempts}" in
		''|*[!0-9]*) attempts=10 ;;
	esac
	[ "${attempts}" -gt 0 ] || attempts=1
	while [ "${attempts}" -gt 0 ]; do
		state=$(vpn__interface_state "${interface_id}" 2>/dev/null || true)
		[ "${state}" = up ] && return 0
		attempts=$((attempts - 1))
		[ "${attempts}" -eq 0 ] || sleep "${delay}"
	done
	[ -z "${ERROR_LOG_FILE:-}" ] || \
		printf 'interface-up-timeout interface=%s last-state=%s\n' \
			"${interface_id}" "${state:-unknown}" >>"${ERROR_LOG_FILE}"
	return 1
}

vpn__service_stop_if_running() {
	local service state action_status=0 log
	service=${1}
	log=${MORS_SETUP_DNS_LOG:-}
	state=$(vpn__service_state "${service}") || return 1
	case "${state}" in
		stopped) return 0 ;;
		running) ;;
		*) return 1 ;;
	esac
	vpn__service_action "${service}" stop || action_status=$?
	state=$(vpn__service_state "${service}") || {
		[ "${action_status}" -ne 0 ] && return "${action_status}"
		return 1
	}
	if [ "${state}" = stopped ]; then
		if [ "${action_status}" -ne 0 ] && [ -n "${log}" ]; then
			printf 'service-stop-postcondition-satisfied service=%s action-exit=%s\n' \
				"${service}" "${action_status}" >>"${log}"
		fi
		return 0
	fi
	[ "${action_status}" -eq 0 ] || return "${action_status}"
	return 1
}

vpn__service_wait_running() {
	local service log started now wall logical=0 elapsed=0 remaining action_timeout step state
	local stable_started=-1 stable_seconds timeout_seconds retry_interval kill_after
	service=${1}
	log=${MORS_SETUP_DNS_LOG:-}
	timeout_seconds=${MORS_VPN_SERVICE_STATE_TIMEOUT}
	retry_interval=${MORS_VPN_SERVICE_RETRY_INTERVAL}
	stable_seconds=${MORS_VPN_SERVICE_RUNNING_STABLE_SECONDS}
	kill_after=${MORS_SETUP_DNS_SERVICE_KILL_AFTER:-2}
	case "${timeout_seconds}" in
		''|*[!0-9]*) return 1 ;;
	esac
	case "${retry_interval}" in
		''|*[!0-9]*) return 1 ;;
	esac
	case "${stable_seconds}" in
		''|*[!0-9]*) return 1 ;;
	esac
	case "${kill_after}" in
		''|*[!0-9]*) return 1 ;;
	esac
	started=$(date +%s) || return 1
	while :; do
		now=$(date +%s) || return 1
		wall=$((now - started))
		[ "${wall}" -ge "${logical}" ] && elapsed=${wall} || elapsed=${logical}
		remaining=$((timeout_seconds - elapsed - kill_after))
		[ "${remaining}" -gt 0 ] || break
		action_timeout=${MORS_SETUP_DNS_SERVICE_ACTION_TIMEOUT:-15}
		[ "${action_timeout}" -le "${remaining}" ] || action_timeout=${remaining}
		state=$(vpn__service_state "${service}" "${action_timeout}") || return 1
		now=$(date +%s) || return 1
		wall=$((now - started))
		[ "${wall}" -ge "${logical}" ] && elapsed=${wall} || elapsed=${logical}
		if [ "${state}" = running ]; then
			[ "${stable_started}" -ge 0 ] || stable_started=${elapsed}
			if [ $((elapsed - stable_started)) -ge "${stable_seconds}" ] && \
				[ "${elapsed}" -le "${timeout_seconds}" ]; then
				[ -z "${log}" ] || printf 'service-running-stable service=%s elapsed=%s\n' \
					"${service}" "${elapsed}" >>"${log}"
				return 0
			fi
		else
			stable_started=-1
		fi
		[ "${elapsed}" -ge "${timeout_seconds}" ] && break
		remaining=$((timeout_seconds - elapsed))
		step=${retry_interval}
		[ "${step}" -le "${remaining}" ] || step=${remaining}
		[ "${step}" -gt 0 ] || break
		sleep "${step}"
		logical=$((logical + step))
	done
	[ -z "${log}" ] || printf 'service-running-stability-timeout service=%s elapsed=%s\n' \
		"${service}" "${elapsed}" >>"${log}"
	return 1
}

service_restart(){
	local srv_name srv_initd service
	srv_name=${1}
	srv_initd=${2}
	service="/opt/etc/init.d/${srv_initd}"
	ready "Перезапускаем ${srv_name}"
	if vpn__service_action "${service}" restart &> /dev/null; then
		when_ok "УСПЕШНО"
	else
		when_bad "ОШИБКА"
		error "Запустите диагностику командой mors debug"
		return 1
	fi
	return 0
}

all_services_restart() {
	local result=0 adguard_state=missing
	if [ -x "${ADGUARDHOME_DEMON}" ]; then
		adguard_state=$(vpn__service_state "${ADGUARDHOME_DEMON}") || return 1
	fi
	if [ "${adguard_state}" = running ]; then
		log_warning 'Перезапуск DNS сервера AdGuardHome'

		service_restart 'DNS сервер AdGuardHome' 'S99adguardhome' || result=1
	else
		log_warning 'Перезапуск служб DNS'

		service_restart 'DNS сервер DNSMasq'  'S56dnsmasq' || result=1
		service_restart 'DNS сервер DNSCrypt' 'S09dnscrypt-proxy2' || result=1
	fi

	if is_shadowsocks_enabled ; then
		log_warning 'Перезапуск клиента ShadowSocks (рестарт всех служб)'

		service_restart 'клиент ShadowSocks' 'S22shadowsocks' || result=1
	elif is_vless_over_proxy_enabled ; then
		log_warning 'Перезапуск клиента VLESS'

		service_restart 'клиент VLESS' 'S24xray' || result=1
	fi
	return "${result}"
}


is_dns_override() {
	curl -s '127.0.0.1:79/rci/opkg/dns-override' | grep -qF 'true'
}

get_dhcpv6_status() {
	local api_ipv6
	api_ipv6=$(curl -s '127.0.0.1:79/rci/ipv6' | jq -c '.')

	if [ "${api_ipv6}" == '{}' ]; then
		# Не факт, что IPv6 DNS отключен вместе с сегментом
		# no ipv6 subnet Default
		echo 'сегмент IPv6 отключен'
		return
	fi

	if ! echo "${api_ipv6}" | grep -qF '"Default":'; then
		# Сегмент IPv6 Default удалён, но не факт, что IPv6 DNS отключен
		echo 'сегмент IPv6 не стандартный'
		return
	fi

	if echo "${api_ipv6}" | grep -qF '"dhcp":true'; then
		# mode dhcp
		echo 'DHCPv6 включен'
		return
	fi

	if echo "${api_ipv6}" | grep -qF '"bind":'; then
		# bind Home
		echo 'сегмент IPv6 привязан'
		return
	fi

	echo 'сегмент IPv6 отвязан и DHCPv6 отключен'
}


config__get_opkg_file() {
	if [ -z "${1}" ]; then
		error "[${FUNCNAME}] Не передан обязательный параметр — файл"
		return
	fi

	echo "${1}-opkg"
}

config__backup_as_opkg_if_not_exist() {
	if [ -z "${1}" ]; then
		error "[${FUNCNAME}] Не передан обязательный параметр — файл"
		return
	fi
	local source_file="${1}"

	local backup_file
	backup_file=$(config__get_opkg_file "${source_file}")

	if [ -f "${backup_file}" ]; then
		# копия уже есть, только первая соответствует opkg
		return
	fi

	log_warning "Сохранение копии как файла из OPKG в ${backup_file}"
	cp "${source_file}" "${backup_file}"
}

config__restore_from_opkg() {
	if [ -z "${1}" ]; then
		error "[${FUNCNAME}] Не передан обязательный параметр — файл"
		return
	fi
	local source_file="${1}"

	local backup_file
	backup_file=$(config__get_opkg_file "${source_file}")

	if ! [ -f "${backup_file}" ]; then
		# исходный opkg-файл не найден
		return
	fi

	log_warning "Восстановление исходного файла ${source_file}"
	mv -f "${backup_file}" "${source_file}"
}


