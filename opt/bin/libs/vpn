# ------------------------------------------------------------------------------------------
#
#	ВКЛючаем VPN клиента
#	$1 - id интерфейса в entware
#
# ------------------------------------------------------------------------------------------

vpn_on() {
	local operation_result state status

	inface_entware="${1}"
	inface_cli=$(grep "${inface_entware}" "${INFACE_NAMES_FILE}" | cut -d '|' -f1 )
	inface_cli_desc=$(grep "${inface_entware}" "${INFACE_NAMES_FILE}" | cut -d '|' -f3 )
	if [ -z "${inface_cli}" ] || [ -z "${inface_cli_desc}" ]; then
		vpn__lifecycle_failure setup.switch.vpn.interface_mapping 1
		return 1
	fi

	ready "Интерфейс ${inface_cli_desc} подключен "
	{
		# Производим замену в библиотеке ndm основных значения интерфейсов
		ndm_interface_change "${inface_entware}" "${inface_cli}" || {
			status=$?
			vpn__lifecycle_failure setup.switch.vpn.interface_config "${status}"
			return "${status}"
		}

		if [ "${MORS_DEFER_SYSTEM_HOOKS:-false}" != true ]; then
			cp "/opt/apps/${APP_NAME}/etc/ndm/netfilter.d/100-vpn-mark" "/opt/etc/ndm/netfilter.d/100-vpn-mark" || return 1
			chmod +x "/opt/etc/ndm/netfilter.d/100-vpn-mark" || return 1

			cp "/opt/apps/${APP_NAME}/etc/ndm/iflayerchanged.d/100-mors-vpn" "/opt/etc/ndm/iflayerchanged.d/100-mors-vpn" || return 1
			chmod +x "/opt/etc/ndm/iflayerchanged.d/100-mors-vpn" || return 1
		fi

		state=$(vpn__interface_state "${inface_cli}") || {
			status=$?
			vpn__lifecycle_failure setup.switch.vpn.interface_state "${status}"
			return "${status}"
		}

		if [ "${state}" = 'down' ]; then
			curl -fsS -d '{"up":"true"}' "${INFACE_PART_REQUEST}/${inface_cli}" &> /dev/null || {
				status=$?
				vpn__lifecycle_failure setup.switch.vpn.interface_up_request "${status}"
				return "${status}"
			}
		fi
		if ! vpn__wait_interface_up "${inface_cli}"; then
			when_bad "ОШИБКА"
			error "Возникла ошибка при подключении интерфейса ${inface_entware}!"
			error "Проверьте доступность сервера и настройки клиента!"
			vpn__lifecycle_failure setup.switch.vpn.interface_up_timeout 1
			return 1
		fi
		update_iptables || {
			status=$?
			vpn__lifecycle_failure setup.switch.vpn.dataplane "${status}"
			return "${status}"
		}
	} 1> /dev/null 2> "${ERROR_LOG_FILE}"
	operation_result=$?
	if [ "${operation_result}" -ne 0 ]; then
		ready_status 1 "Возникла ошибка при подключении VPN соединения [${inface_cli_desc}]" "УСПЕШНО"
		return 1
	fi
	ready_status 0 "Возникла ошибка при подключении VPN соединения [${inface_cli_desc}]" "УСПЕШНО"
	return 0

}

active_backup_config(){
	echo "Обнаружен архивный файл конфигурации shadowsocks."
	answer=''; read_ynq_timer "Удалить его и создать новый" answer N 6
	if [ "${answer}" = q ] ; then exit_q; print_line; exit 1; fi
	if echo "${answer}" | grep -qi y ; then
		ready "Удаляем архивный файл конфигурации shadowsocks..."
		if rm -f "${SHADOWSOCKS_CONF}.mors"; then
			when_ok "УСПЕШНО"
			return 0
		fi
		when_bad "ОШИБКА"
		return 1
	else
		ready "Восстанавливаем файл конфигурации shadowsocks из архива   "
		if cp "${SHADOWSOCKS_CONF}.mors" "${SHADOWSOCKS_CONF}" &>/dev/null; then
			when_ok "УСПЕШНО"
			return 0
		fi
		when_bad "ОШИБКА"
		return 1
	fi
}
# ------------------------------------------------------------------------------------------
#
#	Сохраняем данные для shadowsocks в архивный файл ${SHADOWSOCKS_CONF}.mors
#
# ------------------------------------------------------------------------------------------
shadowsocks_backup() {
	local shadowsocks_state shadowsocks_init
	shadowsocks_init=$(shadowsocks_init__path) || return 1
	# Проверяем установлен ли сервис shadowsocks
	if [ -f "${SSR_CMD}" ] && [ -f "${shadowsocks_init}" ]; then
		# меняем данные в файлах shadowsocks
		sed -i 's/ss-local/ss-redir/g' "${shadowsocks_init}" || return 1

	#	Проверяем на наличие запуска сервиса shadowsocks
		shadowsocks_state=$(vpn__service_state "${shadowsocks_init}") || return 1
		if [ "${shadowsocks_state}" = running ]; then
			print_line
			ready "Останавливаем сервис shadowsocks..."
			if vpn__service_action "${shadowsocks_init}" stop &>/dev/null; then
				when_ok "УСПЕШНО"
			else
				when_bad "ОШИБКА"
				error "Невозможно остановить сервис shadowsocks"
				return 1
			fi
		fi
		if [ -f "${SHADOWSOCKS_CONF}" ] ; then
			if grep -qE '""|@|127.0.0.1|barfoo!' "${SHADOWSOCKS_CONF}"; then
				shadowsocks_read_data || return 1
			fi
		else
			if [ -f "${SHADOWSOCKS_CONF}.mors" ] && \
				! grep -qE '""|@|127.0.0.1|barfoo!' "${SHADOWSOCKS_CONF}.mors" ; then
				active_backup_config || return 1
			else
				shadowsocks_read_data || return 1
			fi
		fi
		return 0
	else
		error "Shadowsocks сервис не установлен. Дальнейшая установка невозможна."
		return 1
	fi
}

