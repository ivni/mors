# ------------------------------------------------------------------------------------------
#
#       Функция подключает гостевую сеть к активному vpn
#       $1 - ID гостевого моста в entware
#
# ------------------------------------------------------------------------------------------
bridge_access_add() {
		local guest_bridge_id _id cli_inface has_guest_nets point guest_net_ip
		guest_bridge_id=${1}
# set -xe
		_id=$(echo "${guest_bridge_id}" | sed 's/[a-z]//g') || return 1
		cli_inface=$(curl -fsS "${INFACE_REQUEST}" | jq -er '.[] | select(.address != null and .id == "'"Bridge${_id}"'") | .description') || return 1
		ready "Добавление гостевого интерфейса '${cli_inface}' завершено"
# set +xe
#		если сеть уже есть в списке, то пропускаем добавление
		grep INFACE_GUEST_ENT "${MORS_CONF_FILE}" | grep -q "${guest_bridge_id}" || {
			has_guest_nets=$(cat <  "${MORS_CONF_FILE}" | sed -n 's/INFACE_GUEST_ENT=\(.*\)/\1/p')
			[ -n "${has_guest_nets}" ] && point=',' || point=''
			sed -i "s/\(INFACE_GUEST_ENT=.*\)/\1${point}${guest_bridge_id}/g; s/[ ]//g" "${MORS_CONF_FILE}" || return 1
		}

#       Слушаем 53 порт гостевого интерфейса
		guest_net_ip=$(ip4 a | grep global | grep -E ' '"${guest_bridge_id}" | sed 's/inet \(.*\)\/.*/\1/' | tr -d ' ') || return 1
		[ -n "${guest_net_ip}" ] || return 1
        if cmd_adguardhome_status | grep -q "ВКЛЮЧЕН" ; then
#           Если доступен ADGUARDHOME
			grep -q "\- ${guest_net_ip}" "${ADGUARDHOME_CONFIG}" || \
				sed -i '/bind_hosts/,/port/ s/.*\(port.*\)/    - '"${guest_net_ip}"'\n  \1/1' "${ADGUARDHOME_CONFIG}" || return 1
        else
#           Если сейчас работает только dnsmasq
			grep -q "listen-address=${guest_net_ip}" "${DNSMASQ_CONFIG}" || \
				sed -i '/listen-address/,/port/ s/.*\(port.*\)/listen-address='"${guest_net_ip}"'\n\1/' "${DNSMASQ_CONFIG}" || return 1

        fi
		when_alert "УСПЕШНО"
		return 0
}

ikev2_setup() {
	ikev2_data="${1}"
	enable=${2:-true}

	ikev2_dns=$(get_router_ip)
	#TODO: вынести получение параметра в функцию
	dns_server=$(echo "${ikev2_data}" | grep -F -- 'dns-server' | cut -d':' -f2 | sed 's/[\,\" ]//g;')
	enable=$(echo "${ikev2_data}"     | grep -F    'enable'     | cut -d':' -f2 | sed 's/[\,\" ]//g;')
	nat=$(echo "${ikev2_data}"        | grep -F    'nat'        | cut -d':' -f2 | sed 's/[\,\" ]//g;')
	if [ "${dns_server}" != "${ikev2_dns}" ] || [ "${enable}" != true ] || [ "${nat}" != true ] ; then
		# Если DNS отличен от IP роутера, или интерфейс, или NAT отключены
		pool_size=$(echo "${ikev2_data}"   | grep -F -- 'pool-size'   | cut -d':' -f2 | sed 's/[\,\" ]//g;')
		pool_start=$(echo "${ikev2_data}"  | grep -F -- 'pool-start'  | cut -d':' -f2 | sed 's/[\,\" ]//g;')
		multi_login=$(echo "${ikev2_data}" | grep -F -- 'multi-login' | cut -d':' -f2 | sed 's/[\,\" ]//g;')
		sa_compat=$(echo "${ikev2_data}"   | grep -F -- 'sa-compat'   | cut -d':' -f2 | sed 's/[\,\" ]//g;')

		curl -fsS -d '{"enable": '"${enable}"', "nat": true, "dns-server": "'"${ikev2_dns}"'", "pool-size": "'"${pool_size}"'", "pool-start": "'"${pool_start}"'", "multi-login": "'"${multi_login}"'", "sa-compat": "'"${sa_compat}"'"}' \
		 "${LOCALHOST_IP}:79/rci/crypto/virtual-ip-server-ikev2" &> /dev/null || return 1
		sleep 1
	fi
}

add_ikev2_net_to_config(){
        has_guest_nets=$(cat <  "${MORS_CONF_FILE}" | sed -n 's/INFACE_GUEST_ENT=\(.*\)/\1/p;'| sed 's/[ ]//g')
        [ -n "${has_guest_nets}" ] && point=',' || point=''
		del_ikev2_net_from_config || return 1
		sed -i "s/\(INFACE_GUEST_ENT=.*\)/\1${point}ikev2/g; s/[ ]//g" "${MORS_CONF_FILE}" || return 1
}

ikev2_net_access_add() {
	local ikev2_settings net_pool
	ikev2_settings=$(curl -fsS "${LOCALHOST_IP}:79/rci/crypto/virtual-ip-server-ikev2") || return 1

	# вероятное изменение настроек роутера
	ikev2_setup "${ikev2_settings}" || return 1

	net_pool=$(echo "${ikev2_settings}" | grep -F -- 'pool-start' | cut -d':' -f2 | sed 's/[\,\" ]//g;') || return 1
	ready "Добавление гостевого интерфейса \"VPN-сервер IKEv2\" [${net_pool}] завершено"
	if ip4__add_routing_by_list_for_net 'ikev2' && add_ikev2_net_to_config; then
		when_alert "УСПЕШНО"
		return 0
	fi
	when_bad "С ОШИБКОЙ"
	return 1
}

bridge_vpn_access_add() {
	guest_bridge_id=${1}

	if [ -n "${guest_bridge_id}" ]; then
		if echo "${guest_bridge_id}" | grep -iq ikev2 ; then
			ikev2_net_access_add || return 1
		else
			bridge_access_add "${guest_bridge_id}" || return 1

			if has_ssr_enable; then
				ip4__add_routing_by_list_for_net "${guest_bridge_id}" || return 1
			fi
		fi
	fi
	return 0
}

