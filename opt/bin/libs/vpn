# ------------------------------------------------------------------------------------------
#
#	 Устанавливаем с нуля dnscrypt_proxy2
#
# ------------------------------------------------------------------------------------------
dns_crypt_install() {
	local dnscrypt_state
	is_install_stage="${1}"
	local activation_mode=runtime
	[ -n "${is_install_stage}" ] && activation_mode=prepare
#	В случае наличия архива файла запуска сервиса dnscrypt_proxy2
	if [ -f /opt/etc/init.d/K09dnscrypt-proxy2 ]; then
		#warning "Обнаружен архив файла S09dnscrypt-proxy2."
		ready "Восстанавливаем S09dnscrypt-proxy2 из архива..."
#		реанимируем его из архива
		cp /opt/etc/init.d/K09dnscrypt-proxy2 /opt/etc/init.d/S09dnscrypt-proxy2 1> /dev/null 2> "${ERROR_LOG_FILE}"
		ready_status "${?}" "Ошибка при восстановлении S09dnscrypt-proxy2 из архива"
	else
		# Если запуск функции был не при установке пакета Морс
			if [ -z "${is_install_stage}" ]; then
		#		при его отсутствии - устанавливаем пакет
				if ! [ -f /opt/etc/init.d/S09dnscrypt-proxy2 ]; then
					ready "Устанавливаем пакет dnscrypt-proxy2..."
					opkg update &> /dev/null
					opkg remove dnscrypt-proxy2 --force-depends 1> /dev/null 2> "${ERROR_LOG_FILE}"
					opkg install dnscrypt-proxy2 --force-maintainer 1> /dev/null 2> "${ERROR_LOG_FILE}"
					when_error "${?}" "Ошибка при установке пакета dnsmasq"
				fi
			else
				if ! [ -f /opt/etc/init.d/S09dnscrypt-proxy2 ]; then
	#				Если вызвана функция из postinst
					error "Пакет dnscrypt-proxy2 был установлен с ошибками или поврежден!"
					error "Файл запуска пакета /opt/etc/init.d/S09dnscrypt-proxy2 отсутствует!"
					warning "Удалите Морс и затем переустановите пакет dnscrypt-proxy2"
					return 1
				fi
			fi


	fi
#	Если dnscrypt_proxy2 запущен, то останавливаем его,
#	так как необходимо его предварительно настроить
	dnscrypt_state=$(vpn__service_state /opt/etc/init.d/S09dnscrypt-proxy2) || return 1
	if [ "${dnscrypt_state}" = running ]; then
		ready "Останавливаем службу dnscrypt-proxy2..."
		if vpn__service_action /opt/etc/init.d/S09dnscrypt-proxy2 stop 1> /dev/null 2> "${ERROR_LOG_FILE}"; then
			ready_status 0 "Проблема при остановке службы dnscrypt-proxy2"
		else
			ready_status 1 "Проблема при остановке службы dnscrypt-proxy2"
			return 1
		fi
	fi

	if [ -f "${DNSCRYPT_CONFIG}" ]; then
		config__backup_as_opkg_if_not_exist "${DNSCRYPT_CONFIG}"

		cp -f "${DNSCRYPT_CONFIG}" "${DNSCRYPT_CONFIG_BACKUP}"
	elif [ -f "${DNSCRYPT_CONFIG_BACKUP}" ]; then
		cp "${DNSCRYPT_CONFIG_BACKUP}" "${DNSCRYPT_CONFIG}"
	else
		config__restore_from_opkg "${DNSCRYPT_CONFIG}"
	fi

	#	Настраиваем сервис
	ready "Настраиваем dnscrypt-proxy2..."
	local activation_result
	: >"${ERROR_LOG_FILE}"
	cmd_dns_crypt_on "${activation_mode}" 1> /dev/null 2> "${ERROR_LOG_FILE}"
	activation_result=$?
	if [ "${activation_result}" -ne 0 ] || [ -s "${ERROR_LOG_FILE}" ]; then
		ready_status 1 "Проблема при активации шифрования DNS трафика"
		return 1
	fi
	ready_status 0 "Проблема при активации шифрования DNS трафика"
	return 0
}
# ------------------------------------------------------------------------------------------
#
#	 Включаем работу блока шифрования dns при помощи dnscrypt_proxy2
#
# ------------------------------------------------------------------------------------------
cmd_dns_crypt_on() {
	local activation_mode=${1:-runtime}
	case "${activation_mode}" in prepare|runtime) ;; *) return 64 ;; esac
	exit_when_adguard_on status; [ "${status}" = 0 ] && {

		crypt_port=$(get_config_value DNS_CRYPT_PORT)
		if [ "${activation_mode}" = runtime ] && [ "$(get_dns_crypt_status)" = on ]; then
			ready "Шифрование DNS уже";	when_ok "ПОДКЛЮЧЕНО"
		else
			dns_crypt_port=$(get_config_value DNS_CRYPT_PORT)
			ready "Шифрование DNS"
			(
				# кэш
				sed -i "s/\(^cache.=.\).*$/\1true/g"           "${DNSCRYPT_CONFIG}" || exit 1
				sed -i "s/\(^cache_min_ttl.=.\).*$/\15/g"      "${DNSCRYPT_CONFIG}" || exit 1
				sed -i "s/\(^cache_max_ttl.=.\).*$/\1129600/g" "${DNSCRYPT_CONFIG}" || exit 1
				sed -i "s/\(^cache_neg_min_ttl.=.\).*$/\11/g"  "${DNSCRYPT_CONFIG}" || exit 1
				sed -i "s/\(^cache_neg_max_ttl.=.\).*$/\11/g"  "${DNSCRYPT_CONFIG}" || exit 1
				# требование безопасности к серверам
				sed -i "s/\(^require_dnssec.=.\).*$/\1true/g" "${DNSCRYPT_CONFIG}" || exit 1
				# пока нет поддержки IPv6
				sed -i "s/\(^block_ipv6.=.\).*$/\1true/g"    "${DNSCRYPT_CONFIG}" || exit 1
				sed -i "s/\(^ipv6_servers.=.\).*$/\1false/g" "${DNSCRYPT_CONFIG}" || exit 1
				# более тяжёлые для роутера
				sed -i "s/^[# ]\{0,1\}[ ]\{0,1\}\(doh_servers.=.\).*$/\1false/g" "${DNSCRYPT_CONFIG}" || exit 1
				# слушаем запросы только с роутера
				sed -i "s/\(^listen_addresses.=.\).*$/\1['127.0.0.1:${crypt_port}']/g" "${DNSCRYPT_CONFIG}" || exit 1
				# в идеале выбрать быстрые для РФ без DoH и IPv6, пока просто динамические
				sed -i "s/^\(server_names =.*\)/# \1/g" "${DNSCRYPT_CONFIG}" || exit 1

				# разрешаем ECH
				sed -i 's/.*\(filter-rr.*\)/# \1/' "${DNSMASQ_CONFIG}" || exit 1

				dns_crypt_port_change "${dns_crypt_port}" norestart || exit 1

				# В setup сервисы запускаются один раз в commit-фазе после проверки
				# подготовленного конфига. Интерактивная команда сохраняет прежний runtime-контракт.
				[ "${activation_mode}" = prepare ] || cmd_mors_init 'no'
			) 1> /dev/null 2>> "${ERROR_LOG_FILE}"
			activation_result=$?
			ready_status "${activation_result}" "Произошла непредвиденная ошибка." "ПОДКЛЮЧЕНО"
			return "${activation_result}"
		fi
	}
}
# ------------------------------------------------------------------------------------------
#
#	 ВЫключаем работу блока шифрования dns при помощи dnscrypt_proxy2
#
# ------------------------------------------------------------------------------------------
cmd_dns_crypt_off() {
	exit_when_adguard_on status; [ "${status}" = 0 ] && {

		ready "Шифрование DNS"
		{
			crypt_port=$(get_config_value DNS_CRYPT_PORT)
			static_dns=$(get_config_value DNS_STATIC_1)

			sed -i "s/\(^server=\)${LOCALHOST_IP}#${crypt_port}/\1${static_dns}/" /opt/etc/dnsmasq.conf
			sed -i 's/.*\(filter-rr.*\)/\1/' /opt/etc/dnsmasq.conf

			sed -i '/echo \"server=/d' '/opt/apps/mors/bin/main/dnsmasq' &> /dev/null
			local server_echo="echo \"server=\/\$\{host\}\/${LOCALHOST_IP}#${crypt_port}\" >> \"\$\{ipset_file\}\""
			sed -i 's/\(done.*\)/\t'"${server_echo}"'\n\n\1/g' '/opt/apps/mors/bin/main/dnsmasq'

			rm "${DNSMASQ_IPSET_HOSTS}"

			set_config_value DNS_DEFAULT "${static_dns}#53"

			# множество конфигов должно обновиться и службы перезапуститься
			cmd_mors_init 'no'
		} 1> /dev/null 2> "${ERROR_LOG_FILE}"
		activation_result=$?
		ready_status "${activation_result}" "Произошла непредвиденная ошибка." "ОТКЛЮЧЕНО"
		return "${activation_result}"
	}
}
