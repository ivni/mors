start_vless(){
	local _inface_entware=${1}
	local enabled_count empty_setup=false status
	xray_version_check || {
		status=$?
		vpn__lifecycle_failure setup.switch.vless.xray_version "${status}"
		return "${status}"
	}
	vless_store__ensure || {
		status=$?
		vpn__lifecycle_failure setup.switch.vless.store "${status}"
		return "${status}"
	}
	enabled_count=$(vless_store__enabled_count) || {
		status=$?
		vpn__lifecycle_failure setup.switch.vless.enabled_count "${status}"
		return "${status}"
	}
	if [ "${enabled_count}" -eq 0 ] && [ "${is_install_stage:-no}" = install ]; then
		empty_setup=true
	elif [ "${enabled_count}" -eq 0 ]; then
		error "Нет включённых VLESS-соединений. Выполните 'mors vless add'."
		vpn__lifecycle_failure setup.switch.vless.no_connections 1
		return 1
	fi
	if [ "${empty_setup}" = false ] && [ "$(vless_store__is_paused)" = true ]; then
		error "VLESS приостановлен. Выполните 'mors vless resume'."
		vpn__lifecycle_failure setup.switch.vless.paused 1
		return 1
	fi
	vless_domain__apply_generated "$(vless_runtime__active_id)" false || {
		status=$?
		vpn__lifecycle_failure setup.switch.vless.config_apply "${status}"
		return "${status}"
	}

	# Проверка конфигурации xray
	check_xray_config=$(${XRAY} run -test -c "${VLESS_CONFIG_FILE}" 2>&1)

	if echo "${check_xray_config}" | grep -q "Configuration OK" ; then

		# Запуск xray в случае, если конфигурация xray не содержит ошибок
		ready "Запускаем xray сервис..."
		if vpn__service_action "${XRAY_INIT}" restart; then
			if vpn__service_wait_running "${XRAY_INIT}"; then
				when_ok "УСПЕШНО"
			else
				when_bad "ОШИБКА"
				vpn__lifecycle_failure setup.switch.vless.xray_ready 1
				return 1
			fi
		else
			status=$?
			when_bad "ОШИБКА"
			vpn__lifecycle_failure setup.switch.vless.xray_restart "${status}"
			return "${status}"
		fi
		# Setup активирует supervisor отдельно, после проверки dataplane. Для
		# запуска supervisor его собственный runtime-lock должен кратковременно
		# стать внешним по отношению к setup-транзакции.
		if [ "${empty_setup}" = false ] && [ "${is_install_stage:-no}" != install ]; then
			[ ! -f "${VLESS_SUPERVISOR_INIT}" ] || \
				vless_runtime__supervisor_service restart &> /dev/null || {
				status=$?
				vpn__lifecycle_failure setup.switch.vless.supervisor_restart "${status}"
				return "${status}"
			}
		else
			[ ! -f "${VLESS_SUPERVISOR_INIT}" ] || \
				vless_runtime__supervisor_service stop &> /dev/null || {
				status=$?
				vpn__lifecycle_failure setup.switch.vless.supervisor_stop "${status}"
				return "${status}"
			}
		fi
		vpn_on "${_inface_entware}" &> /dev/null || {
			status=$?
			vpn__lifecycle_failure setup.switch.vless.proxy_activate "${status}"
			return "${status}"
		}
		if [ "${empty_setup}" = true ]; then
			warning "VLESS ещё не настроен: трафик закрыт до выполнения 'mors vless add'."
			return 0
		fi
		# Тестируем работу proxy vless
		test_vless_proxy || {
			status=$?
			vpn__lifecycle_failure setup.switch.vless.proxy_test "${status}"
			return "${status}"
		}


	else
		# В случае, если есть ошибки в файле конфигурации, выводим их в консоль
		echo -e "${BLUE}В файле ${VLESS_CONFIG_FILE} обнаружены следующие ошибки:${NOCL}"
		print_line
		echo -e "${RED}${check_xray_config}${NOCL}"
		vpn__lifecycle_failure setup.switch.vless.config_test 1
		return 1
	fi
}

switch_vpn_on(){
	local xray_state status
#	entware интерфейс
	inface_entware=${1}
	cli_inface=${2}
#	Меняем интерфейс в файле ndm
	ndm_interface_change "${inface_entware}" "${cli_inface}" || {
		status=$?
		vpn__lifecycle_failure setup.switch.interface "${status}"
		return "${status}"
	}

	# Останавливаем xray, если запушен
	xray_state=$(vpn__service_state "${XRAY_INIT}") || {
		status=$?
		vpn__lifecycle_failure setup.switch.xray_status "${status}"
		return "${status}"
	}
	if [ "${xray_state}" = running ]; then
		vpn__service_stop_if_running "${XRAY_INIT}" &> /dev/null || {
			status=$?
			vpn__lifecycle_failure setup.switch.xray_stop "${status}"
			return "${status}"
		}
	fi
	[ ! -f "${VLESS_SUPERVISOR_INIT}" ] || \
		vless_runtime__supervisor_service stop &> /dev/null || {
		status=$?
		vpn__lifecycle_failure setup.switch.supervisor_stop "${status}"
		return "${status}"
	}

	if [[ "${inface_entware}" =~ ${SSR_ENTWARE_TEMPL} ]]; then
		vpn_off &> /dev/null || return 1
		shadowsocks_backup || return 1
		shadowsocks_on || return 1

	else
		shadowsocks_off &> /dev/null || {
			status=$?
			vpn__lifecycle_failure setup.switch.shadowsocks_off "${status}"
			return "${status}"
		}

		# Если выбран proxy vless mors интерфейс
		if [ "${cli_inface}" = "${PROXY_VLESS_NAME}" ] ; then
			start_vless "${inface_entware}" || {
				status=$?
				vpn__lifecycle_failure setup.switch.vless_start "${status}"
				return "${status}"
			}
		else
			# Если выбран другой VPN интерфейс
			vpn_on "${inface_entware}" || return 1
		fi
	fi
	if [ "${is_install_stage}" = no ]; then
		cmd_mors_init "no" &> /dev/null || return 1
	fi

	#------------------------------------------------------
	# Если есть подключенные гостевые сети
	#------------------------------------------------------
	interfaces_list=$(get_guest_inface_list_from_config) || return 1
	if [ -n "${interfaces_list}" ]; then
		while IFS= read -r iface ; do
#			ready "Подключаем гостевые сети к выбранному VPN подключению..."
			[ -z "${iface}" ] || bridge_vpn_access_add "${iface}" || return 1
		done <<EOF
${interfaces_list}
EOF
	fi

	if [ "${MORS_DEFER_SYSTEM_HOOKS:-false}" = true ]; then
		:
	elif [ "${cli_inface}" = "${PROXY_VLESS_NAME}" ]; then
		rm -f /opt/etc/cron.5mins/check_vpn || return 1
		[ -f /opt/etc/cron.5mins/vless-watchdog ] || \
			ln -s /opt/apps/mors/bin/main/vless-watchdog /opt/etc/cron.5mins/vless-watchdog || return 1
	else
		[ -f /opt/etc/cron.5mins/check_vpn ] || {
			ready "Устанавливаем проверку зависания VPN соединения в cron."
			if ln -s /opt/apps/mors/bin/main/check_vpn /opt/etc/cron.5mins/check_vpn; then
				when_ok "УСПЕШНО"
			else
				when_bad "ОШИБКА"
				return 1
			fi
		}
	fi
	return 0
}

# ------------------------------------------------------------------------------------------
#
#	Переключаем интерфейс клиента
#   $1  - ask - делаем запросы на ввод данные ,
#   	  no - список интерфейсов не обновляем
#
# ------------------------------------------------------------------------------------------
select_vpn_interface() {

	is_install_stage="${1:-no}"

	warning "Выберите VPN интерфейс для работы пакета"
	print_line
#	Отображаем список текущих интерфейсов с номерами по порядку и данными об их доступности
	show_vpn_list

	total=$(cat < "${INFACE_NAMES_FILE}" | wc -l)
	while true; do
		print_line
		echo -en "${BLUE}Выберите номер варианта VPN соединения 1 - ${total} | S-скан. | Q-выход:${NOCL} "
		read -r num_vpn_inface
		if [[ "$num_vpn_inface" =~ ^[\-]?[0-9]+$ ]]; then
			print_line
			set_config_value "ADDR_MAN" ""
			if [[ "$num_vpn_inface" -ge 1 && "$num_vpn_inface" -le "$total" ]]; then
# set -x
	#			Если выбрали уже интерфейс
		#		Меняем интерфейс в файле ndm
				inface_entware=$(get_vpn_interface_by_num "${num_vpn_inface}")
				cli_inface=$(grep "${inface_entware}" "${INFACE_NAMES_FILE}" | cut -d"|" -f1)
				switch_vpn_on "${inface_entware}" "${cli_inface}" || return 1

			else
				error "Число должно быть в пределах от 1 до ${total}"
				continue
			fi
		elif [[ "$num_vpn_inface" =~ ^[Qq]$ ]]; then
			print_line
#			Если нажали на q
			echo -e "${RED}Процедура настройки прервана пользователем!${NOCL}"
			print_line
#			если интернет отключен, то выдаем сообщение
			if curl -s "http://localhost:79/rci/show/interface" | \
				jq -r '.[] | select(.id=="'"$(get_defaultgw_id)"'" and .state=="up" and .link=="up") | .connected' | grep -qv 'yes' ; then

				if cmd_adguardhome_status | grep -q ВКЛЮЧЕН ; then
					/opt/etc/init.d/S56dnsmasq stop  &> /dev/null
				else
					"${ADGUARDHOME_DEMON}" stop &> /dev/null
				fi
				cli="$(get_router_host)/a"
				echo -e "${RED}К сожалению, у Вас пропал интернет. ${NOCL}"
				echo -e "${RED}Проверьте основное подключение к провайдеру. ${NOCL}"
				print_line
				echo "Если ничего не помогает, то для восстановления подключения"
				echo -e "необходимо зайти в админ панель роутера по адресу: ${GREEN}${cli}${NOCL}"
				echo "и выполнить последовательно три следующих команды: "
				print_line
				echo -e "1. ${GREEN}no opkg dns-override ${NOCL}       - вновь подключаем DNS провайдера,"
				echo -e "2. ${GREEN}system configuration save ${NOCL}  - сохраняем изменения,"
				echo -e "3. ${GREEN}system reboot ${NOCL}              - перегружаем роутер."
				print_line
				exit 1
			fi
			exit
		elif [[ "$num_vpn_inface" =~ ^[Ss]$ ]]; then
			print_line
			cmd_interface_change "yes" "${is_install_stage}"
		else
			error "Введите цифру 1-${total} или S - сканирование, Q - выход."
			continue
		fi
		break
	done

}

