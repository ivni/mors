# Пересоздаем таблицу ipset для AdGuard Home и перезапускаем сервис
refresh_adguard_ipset_table(){
	ready "${prefix}Заполняем AdGuard таблицу данными из защищенного списка."
	if /opt/apps/mors/bin/main/adguard &>/dev/null; then
		when_ok "УСПЕШНО"
		return 0
	fi
	when_bad "ОШИБКА"
	return 1
}

update_ipset(){
	stage="${1}"

	ready "${prefix}Заполняем ipset таблицу данными из защищенного списка"
	# Worker участвует в общей runtime-транзакции. Запускаем синхронно, чтобы
	# унаследованный reentrant token не позволял ему менять ipset параллельно с
	# оставшейся частью init workflow.
	if /opt/apps/mors/bin/main/ipset &> /dev/null; then
		when_ok "УСПЕШНО"
	else
		when_bad "ОШИБКА"
		return 1
	fi

	if [ -f /opt/etc/init.d/S56dnsmasq ] ; then
		refresh_dnsmasq_ipset_table || return 1
	else
		refresh_adguard_ipset_table || return 1
		[ "${stage}" = initd ] || {
			ready "${prefix}Перезапускаем сервис AdGuard Home"
			if vpn__service_action /opt/etc/init.d/S99adguardhome restart &>/dev/null; then
				when_ok "УСПЕШНО"
			else
				when_bad "ОШИБКА"
				return 1
			fi
		}
	fi
	return 0
}

# ------------------------------------------------------------------------------------------
#
# Обновляем правила adblock если этот режим включен
#
# ------------------------------------------------------------------------------------------
update_adblock(){

	if [ -f '/opt/etc/init.d/S56dnsmasq' ]; then
			if cat < '/opt/etc/dnsmasq.conf' | sed 's/^\(.*\)\(#.*\)/\2/; /^#/d; /^$/d' | grep -q "${ADBLOCK_HOSTS_FILE}" &> /dev/null; then
				ready "${prefix}Обновляем данные списка блокировки рекламы."
				if /opt/apps/mors/bin/main/adblock &>/dev/null; then
					when_ok "ГОТОВО"
				else
					when_bad "ОШИБКА"
					return 1
				fi
			fi
	fi
	return 0
}

