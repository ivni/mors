ipv6_bypass__active_dns_aaaa() {
	local target port timeout_command
	target=${1}
	if has_adguard_enable; then
		port=${MAIN_DNS_PORT}
	else
		port=$(get_config_value DNSMASQ_PORT)
	fi
	[ -n "${port}" ] || return 1
	if command -v timeout >/dev/null 2>&1; then
		timeout_command=$(command -v timeout)
	elif [ -x /opt/bin/timeout ]; then
		timeout_command=/opt/bin/timeout
	else
		return 1
	fi
	if command -v kdig >/dev/null 2>&1; then
		"${timeout_command}" 5 kdig @127.0.0.1 -p "${port}" "${target}" AAAA +short
	elif command -v dig >/dev/null 2>&1; then
		"${timeout_command}" 5 dig @127.0.0.1 -p "${port}" "${target}" AAAA +short
	else
		return 1
	fi
}

hint__if_dns_ipv6() {
	if ! ipv6_bypass__detect example.com ipv6_bypass__active_dns_aaaa; then
		return 0
	fi

	local commands_title
	commands_title="$(hint__commands_title)"
	printf '%b\n' \
		"${MORS_IPV6_BYPASS_MESSAGE}" \
		"${commands_title}" \
		' ipv6 subnet Default' \
		' no mode' \
		' no bind' \
		' system configuration save' \
		' system reboot'
}


