XRAY_INIT=/opt/etc/init.d/S24xray

VLESS_CONFIG_FILE=/opt/etc/xray/mors.json
VLESS_CONFIG_ORIGINAL_FILE=/opt/apps/mors/etc/conf/mors.vless
VLESS_CONFIG_FILE_BACKUP=${MORS_BACKUP_PATH}/mors.json

PROXY_VLESS_DESC="Mors-proxy-vless"
