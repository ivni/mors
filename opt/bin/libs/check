#!/bin/sh

# Focused legacy AdGuard command. The old global state checker was removed:
# global diagnostics now live in libs/test and never repair state implicitly.

. /opt/apps/mors/bin/libs/main
. /opt/apps/mors/bin/libs/vpn

cmd_adguard_check() {
	exit_when_dnsmasq_on status
	[ "${status}" = 0 ] || return 1
	ready 'Список правил ipset для AdGuard Home'
	if [ -s "${ADGUARD_IPSET_FILE}" ] && \
		[ "$(wc -c <"${ADGUARD_IPSET_FILE}")" -gt 6 ]; then
		when_ok 'ЗАПОЛНЕН'
		echo_debug 'Журнал загрузки AdGuard Home (последние записи)' \
			"$(tail "${ADGUARDHOME_LOG}" 2>/dev/null)"
		return 0
	fi
	when_bad 'ПУСТ'
	/opt/apps/mors/bin/main/adguard >/dev/null 2>&1
	ready 'Повторная проверка заполнения списка правил ipset для AdGuard Home'
	if [ -s "${ADGUARD_IPSET_FILE}" ] && \
		[ "$(wc -c <"${ADGUARD_IPSET_FILE}")" -gt 6 ]; then
		when_ok 'ПРОЙДЕНА'
		return 0
	fi
	when_bad 'ОШИБКА'
	error 'Список правил AdGuard Home остался пустым.'
	return 1
}
